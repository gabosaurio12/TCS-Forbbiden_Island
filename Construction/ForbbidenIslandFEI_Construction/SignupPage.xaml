<Page x:Class="ForbbidenIslandFEI_Construction.SignupPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ForbbidenIslandFEI_Construction"
        xmlns:p ="clr-namespace:ForbbidenIslandFEI_Construction.Properties"
        mc:Ignorable="d"
        Title="SignupPage" Height="360" Width="450">


    <Grid Margin="70,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="{x:Static p:Resources.signup_title}"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- User -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,5,0,0">
            <TextBlock Text="{x:Static p:Resources.username}" HorizontalAlignment="Left" />
            <TextBox x:Name="txtBUsername" Height="25" Width="280" Margin="0,5" />
        </StackPanel>

        <!-- Email -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,5,0,0">
            <TextBlock Text="{x:Static p:Resources.email}" HorizontalAlignment="Left" />
            <TextBox x:Name="txtBEmail" Height="25" Width="280" Margin="0,5"/>
        </StackPanel>

        <!-- Password -->
        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,5,0,0">
            <TextBlock Text="{x:Static p:Resources.password}" HorizontalAlignment="Left" />
            <TextBox x:Name="txtBPassword" Height="25" Width="280" Margin="0,5" />
        </StackPanel>

        <!-- Register Button -->
        <StackPanel Grid.Row="4" Orientation="Vertical"
                    HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="signupButton" Content="{x:Static p:Resources.signup_button}" 
                    Height="30" Width="150" Background="#39B349" 
                    Foreground="White" FontWeight="Bold"
                    Click="SignupButton_Click" Margin="0,0,0,0"/>
            <Label Content="{x:Static p:Resources.login_title}" Margin="0,5,0,0" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                   MouseDown="Login_MouseDown" Cursor="Hand" />
        </StackPanel>

    </Grid>
</Page>