<Page x:Class="ForbbidenIslandFEI_Construction.PlayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:language="clr-namespace:ForbbidenIslandFEI_Construction.Properties.Langs"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="PlayPage">

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080" Background="White">

            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <!-- Encabezado -->
                <RowDefinition Height="*"/>
                <!-- Contenido -->
                <RowDefinition Height="100"/>
                <!-- Pie -->
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <DockPanel Grid.Row="0" Background="#3CB7FF" LastChildFill="True">
                <!-- Botón de retroceso -->
                <Button Content="⮜" Width="80" Height="80" FontSize="36" Margin="10" DockPanel.Dock="Left"/>

                <!-- Botón de amigos -->
                <Button Content="{x:Static language:Resources.friends}" 
            Background="Gold" Width="250" Height="80" FontSize="28"
            DockPanel.Dock="Right" Margin="10"/>

                <!-- Título centrado -->
                <Grid>
                    <TextBlock Text="{x:Static language:Resources.play}"
                   FontSize="64"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left" Margin="789,0,0,0"/>
                </Grid>
            </DockPanel>


            <!-- Contenido principal -->
            <Grid Grid.Row="1" Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="311*"/>
                    <!-- Configuración -->
                    <ColumnDefinition Width="309*"/>
                    <!-- Multimedia -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <!-- Barra de Tabs -->
                    <RowDefinition Height="*"/>
                    <!-- Contenido dinámico -->
                </Grid.RowDefinitions>

                <!-- Barra superior Host Game / Online -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Orientation="Horizontal">
                    <Button x:Name="HostButton" Content="{x:Static language:Resources.host_game}" Width="927" Height="80" FontSize="28" 
                            Background="LightGray" Click="HostButton_Click"/>
                    <Button x:Name="OnlineButton" Content="{x:Static language:Resources.online}" Width="927" Height="80" FontSize="28"
                            Background="Gainsboro" Click="OnlineButton_Click" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Contenido dinámico con un ContentControl -->
                <ContentControl x:Name="TabContent" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"/>
            </Grid>

            <!-- Pie -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,50,0">
                <Button Content="{x:Static language:Resources.play}" Width="300" Height="80" Background="Orange" FontSize="28" Click="Button_Click"/>
            </StackPanel>

        </Grid>
    </Viewbox>
</Page>
