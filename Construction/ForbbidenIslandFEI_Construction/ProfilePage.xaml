<Page x:Class="ForbbidenIslandFEI_Construction.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ForbbidenIslandFEI_Construction"
      xmlns:p ="clr-namespace:ForbbidenIslandFEI_Construction.Properties"

      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Profile">

    <Grid>
        <StackPanel Orientation="Vertical">
            <Rectangle Fill="#6BB6E4" Opacity="1" Height="270" />
            <Rectangle Fill="White" Opacity="1" Height="830" />
        </StackPanel>
        <TextBlock Text="{x:Static p:Resources.profile}" FontSize="96" HorizontalAlignment="Center" Margin="80" FontFamily="Irish Gover" />

        <Grid Margin="100,400,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Avatar -->

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="{x:Static p:Resources.guest}" FontSize="57" Margin="0,0,0,0" FontFamily="Irish Gover" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" />
                <Ellipse Height="300" Width="300" Fill="#969696" Margin="0,25,0,0" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" />
            </Grid>

            <!-- User Info Form -->
            
            <Grid Grid.Column="1" HorizontalAlignment="Right" Margin="250,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Static p:Resources.username}" Grid.Column="0" Grid.Row="0" FontSize="57" FontFamily="Irish Gover" VerticalAlignment="Center" Margin="20,40,0,0" />
                <TextBox x:Name="txtBxTag" Grid.Column="1" Grid.Row="0" Width="360" Height="66" VerticalAlignment="Center" Margin="20,40,0,0" />

                <TextBlock Text="{x:Static p:Resources.name}" Grid.Column="0" Grid.Row="1" FontSize="57" VerticalAlignment="Center" FontFamily="Irish Gover" Margin="20,40,0,0" />
                <TextBox x:Name="txtBxName" Grid.Column="1" Grid.Row="1" Width="360" Height="66" VerticalAlignment="Center" Margin="20,40,0,0" />

                <TextBlock Text="{x:Static p:Resources.lastName}" Grid.Column="0" Grid.Row="2" FontSize="57" VerticalAlignment="Center" FontFamily="Irish Gover" Margin="20,40,0,0" />
                <TextBox x:Name="txtBxLastName" Grid.Column="1" Grid.Row="2" Width="360" Height="66" VerticalAlignment="Center" Margin="20,40,0,0" />
            </Grid>
            
            <!-- Avatar -->
            <TextBlock Text="{x:Static p:Resources.avatarExplanation}" Grid.Column="0" Grid.Row="1" FontSize="20" FontFamily="Irish Gover" VerticalAlignment="Center" Margin="20,40,0,0" />
            <Button x:Name="btnAvatar" Grid.Column="0" Grid.Row="2" Content="{x:Static p:Resources.uploadAvatar}" Width="238" Height="63" FontSize="24" Margin="0,25,0,0" VerticalAlignment="Center" />
            
            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,0,0">
                <Button x:Name="btnSave" Content="{x:Static p:Resources.saveChanges}" Width="345" Height="100" Margin="0,0,50,0" Background="#83EC38" FontSize="36" VerticalAlignment="Center" />
                <Button x:Name="btnDiscard" Content="{x:Static p:Resources.discardChanges}" Width="345" Height="100" Margin="0,0,50,0" Background="#FFCB2F" FontSize="36" VerticalAlignment="Center" Click="btnDiscard_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
