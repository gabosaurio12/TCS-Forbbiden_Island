<Window x:Class="ForbbidenIslandFEI_Construction.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:language="clr-namespace:ForbbidenIslandFEI_Construction.Properties.Langs"
        mc:Ignorable="d"
        Title="Forbidden Island FEI"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Window.Background>
        <ImageBrush ImageSource="/Images/FEI MainPage.png" Stretch="Fill"/>
    </Window.Background>

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="FORBIDDEN ISLAND"
                           FontSize="80"
                           FontFamily="Irish Grover"
                           TextAlignment="Center"
                           Foreground="Orange"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>
                <TextBlock Text="FEI EDITION"
                           FontSize="40"
                           Foreground="LightBlue"
                           TextAlignment="Center"
                           FontFamily="Arial Black"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0"
                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="710,0,0,0">
                <Button x:Name="playButton" Content="{x:Static language:Resources.play}"
                        Width="500" Height="80" Margin="0,10"
                        BorderThickness="5" BorderBrush="#FFB7B7B7"
                        FontFamily="Bahnschrift Light" FontSize="30"
                        Click="playButton_Click" Background="White"/>
                <Button x:Name="settingsButton" Content="{x:Static language:Resources.settings}"
                        Width="500" Height="80" Margin="0,10"
                        BorderThickness="5" BorderBrush="#FFB7B7B7"
                        FontFamily="Bahnschrift Light" FontSize="30"
                        Click="settingsButton_Click"/>
                <Button x:Name="quitGameButton" Content="{x:Static language:Resources.quit_game}"
                        Width="500" Height="80" Margin="0,10"
                        BorderThickness="5" BorderBrush="#FFB7B7B7"
                        FontFamily="Bahnschrift Light" FontSize="30"
                        Click="quitGameButton_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{x:Static language:Resources.guest}"
                           Foreground="White"
                           FontSize="32"
                           TextAlignment="Center"
                           FontFamily="Georgia"
                           FontStyle="Italic"
                           FontWeight="Bold"
                           Margin="0,0,0,10"
                           Opacity="0.8"/>
                <Grid Width="220" Height="220" Margin="0,0,0,10">
                    <Ellipse Fill="Gray"/>
                    <Ellipse Margin="5">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Images/mach248px.png"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <Button x:Name="profileButton" Content="{x:Static language:Resources.profile}"
                        Width="200" Height="60"
                        FontFamily="Bahnschrift Light" FontSize="30"
                        BorderThickness="5" BorderBrush="#FFB7B7B7"
                        HorizontalAlignment="Center"
                        Click="profileButton_Click"/>
            </StackPanel>

            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="logInButton" Grid.Column="0" Content="{x:Static language:Resources.signin}" 
                        Width="200" Height="80"
                        HorizontalAlignment="Left" Margin="20"
                        BorderThickness="5" BorderBrush="#FFB7B7B7"
                        FontFamily="Bahnschrift Light" FontSize="30"
                        Click="logInButton_Click"/>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
