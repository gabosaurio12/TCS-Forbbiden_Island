<Window x:Class="ForbbidenIslandFEI_Construction.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:ForbbidenIslandFEI_Construction"
        xmlns:p="clr-namespace:ForbbidenIslandFEI_Construction.Properties"
        mc:Ignorable="d" 
        d:DesignHeight="1080" d:DesignWidth="1920"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Title="Profile Window">

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra superior con botón de regreso -->
            <DockPanel Grid.Row="0" Background="#3CB7FF" LastChildFill="True">
                <Button Content="&lt;" Width="80" Height="80" FontSize="36" Margin="10"
                        DockPanel.Dock="Left" Click="BackButton_Click"/>
                <Grid>
                    <TextBlock Text="{x:Static p:Resources.profile}" FontSize="64" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="789,0,0,0"/>
                </Grid>
            </DockPanel>

            <!-- Contenido principal -->
            <Grid Grid.Row="1" Margin="50,50,50,50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="600" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Avatar -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{x:Static p:Resources.guest}" FontSize="57"
                               FontFamily="Irish Gover" Grid.Row="0" HorizontalAlignment="Center" />
                    <Ellipse Height="300" Width="300" Fill="#969696" Margin="0,25,0,0" Grid.Row="1"
                             HorizontalAlignment="Center" />
                </Grid>

                <!-- User Info Form -->
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="80,0,0,0">
                    <TextBlock x:Name="txtBkUsername" Text="{x:Static p:Resources.username}" FontSize="48" FontFamily="Irish Gover"
                               Margin="20,30,0,0" />
                    <TextBlock x:Name="txtBkName" Text="{x:Static p:Resources.name}" FontSize="48" FontFamily="Irish Gover"
                               Margin="20,30,0,0" />
                    <TextBlock x:Name="txtBkEmail" Text="{x:Static p:Resources.email}" FontSize="48" FontFamily="Irish Gover"
                               Margin="20,30,0,0" />
                    <TextBlock Text="{x:Static p:Resources.socialMedia}" FontSize="48" FontFamily="Irish Gover"
                               Margin="20,30,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Vertical">
                    <TextBox x:Name="txtBxUsername" Width="360" Height="45" Margin="20,40,0,0" FontSize="30" />
                    <TextBox x:Name="txtBxName" Width="360" Height="45" Margin="20,40,0,0" FontSize="30" />
                    <TextBox x:Name="txtBxEmail" Width="360" Height="45" Margin="20,40,0,0" FontSize="30" />
                    <TextBox x:Name="txtBxSocialMedia" Width="360" Height="45" Margin="20,40,0,0" FontSize="30" />
                </StackPanel>

                <!-- Avatar -->
                <TextBlock Text="{x:Static p:Resources.avatarExplanation}" Grid.Column="0" Grid.Row="1"
                           FontSize="20" FontFamily="Irish Gover" Margin="20,20,0,0" />
                <Button x:Name="btnAvatar" Content="{x:Static p:Resources.uploadAvatar}"
                        Grid.Column="0" Grid.Row="2" Margin="0,25,0,0"
                        Width="238" Height="63" FontSize="24" />

                <!-- Buttons -->
                <Button x:Name="btnSave" Content="{x:Static p:Resources.saveChanges}" 
                        Grid.Column="1" Grid.Row="2" Margin="0,20,0,0"
                        Width="345" Height="100" Background="#83EC38"
                        FontSize="36" Click="BtnSave_Click" />
                <Button x:Name="btnDiscard" Content="{x:Static p:Resources.discardChanges}"
                        Grid.Column="2" Grid.Row="2" Margin="0,20,0,0"
                        Width="345" Height="100" Background="#FFCB2F"
                        FontSize="36" Click="BtnDiscard_Click" />
            </Grid>
        </Grid>
    </Viewbox>
</Window>