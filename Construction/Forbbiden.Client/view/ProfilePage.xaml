<Page x:Class="Forbbiden.Client.ProfilePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Forbbiden.Client"
        xmlns:p="clr-namespace:Forbbiden.Client.Properties"
        mc:Ignorable="d" 
        d:DesignHeight="1080" d:DesignWidth="1920"
        Title="Profile Page">

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Upper bar and go back button -->
            <DockPanel Grid.Row="0" Background="#3CB7FF" LastChildFill="True">
                <Button Content="&lt;" Width="80" Height="80" FontSize="36" Margin="10" FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                        DockPanel.Dock="Left" Click="BtnDiscard_Click"/>
                <Grid>
                    <TextBlock Text="{x:Static p:Resources.profile}" FontSize="64" FontWeight="Bold" FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="789,0,0,0"/>
                </Grid>
            </DockPanel>
            
            <!-- Back Grid -->
            <Grid Grid.Row="1" Margin="50,50,50,50" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Grid -->
                <Grid Grid.Column="0" Margin="75,100,0,0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Avatar -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                        <Ellipse x:Name="imgAvatar" Height="300" Width="300" Fill="#969696" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Margin="100,100,100,50" Grid.Row="0" />
                        <TextBlock x:Name="txtBkAvatarName" Text="{x:Static p:Resources.guest}" FontSize="57" FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                                   Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{x:Static p:Resources.avatarExplanation}" Grid.Row="1"
                            FontSize="20" FontFamily="Irish Gover" HorizontalAlignment="Center" Margin="0,40,0,40" />
                    <Button x:Name="btnAvatar" Content="{x:Static p:Resources.uploadAvatar}"
                            Grid.Column="0" Grid.Row="2" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                            Margin="0,8,0,0"
                            Width="238" Height="64" FontSize="24"
                            Click="BtnUploadAvatar_Click" />
                </Grid>

                <!-- Right Grid -->
                <Grid Grid.Column="1" Margin="100,0,0,0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="335"/>
                        <RowDefinition Height="250"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- User Info Form -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,30,0">
                        <TextBlock x:Name="txtBkUsername" Text="{x:Static p:Resources.username}" FontSize="48" FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                                   Margin="20,30,0,0" HorizontalAlignment="Right" />
                        <TextBlock x:Name="txtBkName" Text="{x:Static p:Resources.name}" FontSize="48" FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                                   Margin="20,30,0,0" HorizontalAlignment="Right" />
                        <TextBlock x:Name="txtBkEmail" Text="{x:Static p:Resources.email}" FontSize="48" FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                                   Margin="20,30,0,0" HorizontalAlignment="Right" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical" >
                        <TextBox x:Name="txtBxUsername" Width="410" Height="45" Margin="0,40,30,0" FontSize="30" />
                        <TextBox x:Name="txtBxName" Width="410" Height="45" Margin="0,40,30,0" FontSize="30" />
                        <TextBox x:Name="txtBxEmail" Width="410" Height="45" Margin="0,40,30,0" FontSize="30" />
                    </StackPanel>

                    <!-- Socials (Discord-X) -->
                    <Grid Grid.Column="0" Grid.Row="1" Margin="50,20,25,20" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Discord -->
                        <Image Source="/Images/discord.png" Width="87" Height="87" Margin="100,0,0,10" Grid.Column="0" Grid.Row="0" />
                        <TextBox x:Name="txtBxDiscord" Width="300" Height="45" Margin="20,0,0,10" FontSize="30" Grid.Column="1" Grid.Row="0" />

                        <!-- X -->
                        <Image Source="/Images/x.png" Width="87" Height="87" Margin="100,0,0,10" Grid.Column="0" Grid.Row="1" />
                        <TextBox x:Name="txtBxX" Width="300" Height="45" Margin="20,0,0,10" FontSize="30" Grid.Column="1" Grid.Row="1" />
                    </Grid>

                    <!-- Socials (Instagram-Facebook) -->
                    <Grid Grid.Column="1" Grid.Row="1" Margin="0,20,0,20" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Instagram -->
                        <Image Source="/Images/instagram.png" Width="87" Height="87" Margin="0,0,0,10" Grid.Column="0" Grid.Row="0" />
                        <TextBox x:Name="txtBxInstagram" Width="300" Height="45" Margin="20,0,0,10" FontSize="30" Grid.Column="1" Grid.Row="0" />

                        <!-- Facebook -->
                        <Image Source="/Images/facebook.png" Width="87" Height="87" Margin="0,0,0,10" Grid.Column="0" Grid.Row="1" />
                        <TextBox x:Name="txtBxFacebook" Width="300" Height="45" Margin="20,0,0,10" FontSize="30" Grid.Column="1" Grid.Row="1" />
                    </Grid>

                    <!-- Buttons -->
                    <Button x:Name="btnSave" Content="{x:Static p:Resources.saveChanges}" 
                            Grid.Column="0" Grid.Row="2" Margin="0,80,0,0"
                            Width="345" Height="100" Background="#83EC38" FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                            FontSize="36" Click="BtnSave_Click" />
                    <Button x:Name="btnDiscard" Content="{x:Static p:Resources.discardChanges}"
                            Grid.Column="1" Grid.Row="2" Margin="0,80,0,0"
                            Width="345" Height="100" Background="#FFCB2F" FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                            FontSize="36" Click="BtnDiscard_Click" />

                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</Page>