<Page x:Class="Forbbiden.Client.view.FriendsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Forbbiden.Client.view"
      xmlns:language="clr-namespace:Forbbiden.Client.Properties.Langs"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="FriendsPage">

    <Page.Background>
        <ImageBrush ImageSource="/Images/FEI MainPage3.png" Stretch="Fill"/>
    </Page.Background>

    <Grid Width="1920" Height="1080">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Upper bar -->
        <DockPanel Grid.Row="0" Background="#EFC437" LastChildFill="True" Height="152">
            <Button x:Name="backButton"
            Content="&lt;"
            Width="100" Height="100"
            FontSize="40"
            FontFamily="pack://application:,,,/Fonts/#Irish Grover"
            BorderThickness="5" BorderBrush="#FFB7B7B7"
            Background="White"
            Foreground="Black"
            Margin="20,0,0,0"
            Cursor="Hand"
            DockPanel.Dock="Left"
            Click="BackButton_Click"/>

            <TextBlock Text="{x:Static language:Resources.friends}"
               FontSize="60"
               FontWeight="Bold"
               Foreground="White"
               FontFamily="pack://application:,,,/Fonts/#Irish Grover"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Online Friends -->

            <StackPanel x:Name="onlineStack" Grid.Column="0" >
                <TextBlock Text="{x:Static language:Resources.online_friends}"
                           FontSize="64"
                           Foreground="White"
                           FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                           HorizontalAlignment="Center"
                           Margin="0,25"/>
            </StackPanel>

            <StackPanel x:Name="offlineStack" Grid.Column="1">
                <TextBlock Text="{x:Static language:Resources.offline}"
                           FontSize="64"
                           Foreground="White"
                           FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                           HorizontalAlignment="Center"
                           Margin="0,25"/>
            </StackPanel>
            
        </Grid>
    </Grid>
    
</Page>
