<Page x:Class="Forbbiden.Client.view.FriendsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Forbbiden.Client.view"
      xmlns:language="clr-namespace:Forbbiden.Client.Properties.Langs"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="FriendsPage">

    <Page.Background>
        <ImageBrush ImageSource="/Images/FEI MainPage3.png" Stretch="Fill"/>
    </Page.Background>

    <Page.Resources>
        <Storyboard x:Key="ShowSearchBar">
            <DoubleAnimation Storyboard.TargetName="searchtxtBx"
                             Storyboard.TargetProperty="Width"
                             From="0" To="450"
                             Duration="0:0:0.5"
                             AccelerationRatio="0.3" DecelerationRatio="0.3" />
        </Storyboard>
        <Storyboard x:Key="HideSearchBar">
            <DoubleAnimation Storyboard.TargetName="searchtxtBx"
                             Storyboard.TargetProperty="Width"
                             From="450" To="0"
                             Duration="0:0:0.5"
                             AccelerationRatio="0.3" DecelerationRatio="0.3" />
        </Storyboard>
    </Page.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Upper bar -->

            <Grid x:Name="upperGrid" Background="#EFC437" Height="152">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="backButton" Grid.Column="0"
                    Content="&lt;"
                    Width="100" Height="100"
                    HorizontalAlignment="Left"
                    FontSize="40"
                    FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                    BorderThickness="5" BorderBrush="#FFB7B7B7"
                    Background="White"
                    Foreground="Black"
                    Margin="20,0,0,0"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

                <TextBlock Text="{x:Static language:Resources.friends}" Grid.Column="1"
                    FontSize="60"
                    FontWeight="Bold"
                    Foreground="White"
                    FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>

                <DockPanel Grid.Column="2">
                    <Image Source="/Images/glass.png"
                            DockPanel.Dock="Right"
                            Height="100" Width="100" Margin="20,0"
                            Cursor="Hand"
                            MouseLeftButtonDown="SearchFriend_MouseLeftButtonDown"/>

                    <TextBox x:Name="searchtxtBx" Height="60" Width="0"
                             MaxLength="30"
                             FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                             FontSize="40"
                             DockPanel.Dock="Left"
                             VerticalAlignment="Center"
                             Margin="10,0,0,0"
                             Visibility="Visible"/>
                    
                    
                </DockPanel>


            </Grid>

            <Grid Grid.Row="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Online Friends -->

                <StackPanel x:Name="onlineStack" Grid.Column="0" >
                    <TextBlock Text="{x:Static language:Resources.online_friends}"
                        FontSize="64"
                        Foreground="White"
                        FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                        HorizontalAlignment="Center"
                        Margin="0,25"/>
                </StackPanel>

                <StackPanel x:Name="offlineStack" Grid.Column="1">
                    <TextBlock Text="{x:Static language:Resources.offline}"
                       FontSize="64"
                       Foreground="White"
                       FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                       HorizontalAlignment="Center"
                       Margin="0,25"/>
                </StackPanel>

            </Grid>
        </Grid>
    </Viewbox>
</Page>
