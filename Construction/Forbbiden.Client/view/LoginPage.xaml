<Page x:Class="Forbbiden.Client.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Forbbiden.Client"
        xmlns:language ="clr-namespace:Forbbiden.Client.Properties.Langs"
        mc:Ignorable="d"
        Title="LoginPage" >

    <Page.Background>
        <ImageBrush ImageSource="/Images/FEI MainPage3.png" Stretch="Fill"/>
    </Page.Background>

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Background="#0F1945" LastChildFill="True" >
                <Button x:Name="backButton"
                    Content="&lt;"
                    Width="100" Height="100"
                    FontSize="40"
                    FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                    BorderThickness="5" BorderBrush="#FFB7B7B7"
                    Background="White"
                    Foreground="Black"
                    Margin="20,0,0,0"
                    Cursor="Hand"
                    DockPanel.Dock="Left"
                    Click="BackButton_Click"/>

                <TextBlock Text="{x:Static language:Resources.login_title}"
                   FontSize="60"
                   FontWeight="Bold"
                   Foreground="White"
                   FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
            </DockPanel>

            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- User/email -->
                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,5,0,0" HorizontalAlignment="Center">
                    <TextBlock x:Name="txtBkUser" Text="{x:Static language:Resources.username_email}" HorizontalAlignment="Left"
                               FontSize="20" Foreground="White" FontFamily="pack://application:,,,/Fonts/#Irish Grover" />
                    <TextBox x:Name="txtBUsername" Height="35" Width="340" Margin="0,5" FontSize="20" />
                </StackPanel>

                <!-- Password -->
                <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,5,0,0" HorizontalAlignment="Center">
                    <TextBlock x:Name="txtBkPassword" Text="{x:Static language:Resources.password}" HorizontalAlignment="Left"
                               FontSize="20" Foreground="White" FontFamily="pack://application:,,,/Fonts/#Irish Grover" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <PasswordBox x:Name="pwdBPassword" Height="35" Width="280" Margin="5" FontSize="20" />
                        <TextBox x:Name="txtBPasswordVisible" Height="35" Width="280" Visibility="Collapsed"  Margin="5" FontSize="20" />
                        <CheckBox x:Name="chkPassword" Content="{x:Static language:Resources.show_password}" VerticalAlignment="Center" Click="TogglePassword_Click" Foreground="White" FontFamily="pack://application:,,,/Fonts/#Irish Grover" >
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        <!--<Button x:Name="btnTogglePassword" Content="{x:Static p:Resources.show_password}" Width="50" Height="25" Margin="5" Click="btnTogglePassword_Click"/> -->
                    </StackPanel>
                </StackPanel>

                <!-- Register Button -->
                <StackPanel Grid.Row="3" Orientation="Vertical"
                    HorizontalAlignment="Center" Margin="0,20,0,0">
                    <CheckBox x:Name="chkRememberMe" Content="{x:Static language:Resources.remember_me}" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="White" FontFamily="pack://application:,,,/Fonts/#Irish Grover" >
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <Button x:Name="signupButton" Content="{x:Static language:Resources.login_button}" Height="35" Width="150" Background="#39B349" Foreground="White" FontSize="16" FontFamily="pack://application:,,,/Fonts/#Irish Grover" Click="BtnLogin_Click" />
                    <Label Content="{x:Static language:Resources.signup_title}" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="Signup_MouseDown" Cursor="Hand" FontSize="14" Foreground="White" FontFamily="pack://application:,,,/Fonts/#Irish Grover" />
                </StackPanel>
            </Grid>
            <Image Source="/Images/codebackground.png" Grid.Row="1" Margin="1296,283,171,379" />
            <Image x:Name="bossImage" Source="/Images/boss.png" HorizontalAlignment="Left" Height="292" Margin="1532,244,0,0" Grid.Row="1" VerticalAlignment="Top" Width="312" RenderTransformOrigin="0.652,0.965"/>
            <TextBlock Text="{x:Static language:Resources.bossLogin}" HorizontalAlignment="Left" Margin="1320,325,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Height="187" Width="280" 
                       FontSize="32" Foreground="Wheat" FontFamily="Consolas" />
        </Grid>
    </Viewbox>
</Page>