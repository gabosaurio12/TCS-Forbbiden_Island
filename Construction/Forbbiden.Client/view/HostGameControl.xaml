<UserControl x:Class="Forbbiden.Client.HostGameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:language="clr-namespace:Forbbiden.Client.Properties.Langs" >

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel Izquierdo -->
        <StackPanel Grid.Column="0" Margin="20">

            <!-- Número de jugadores -->
            <StackPanel Orientation="Horizontal" Margin="0,20">
                <TextBlock Text="{x:Static language:Resources.max_players}" FontSize="28" VerticalAlignment="Center"/>
                <ComboBox Width="120" Height="50" FontSize="24" Margin="20,0,0,0">
                    <ComboBoxItem Content="2" IsSelected="True"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                </ComboBox>
            </StackPanel>

            <!-- Dificultad -->
            <TextBlock Text="{x:Static language:Resources.difficulty}" FontSize="28" Margin="0,30,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="NormalButton" Content="{x:Static language:Resources.normal}" 
                        Width="160" Height="80" Background="LightGreen" FontSize="24" 
                        Margin="0,0,20,0" Click="NormalButton_Click"/>
                <Button x:Name="HardButton" Content="{x:Static language:Resources.hard}" 
                        Width="160" Height="80" Background="LightCoral" FontSize="24" 
                        Click="HardButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="NormalMessage" Text="{x:Static language:Resources.normal_message}" 
                       FontSize="18" Foreground="Gray" Margin="0,10,0,0" Visibility="Visible"/>
            <TextBlock x:Name="HardMessage" Text="{x:Static language:Resources.hard_message}" 
                       FontSize="18" Foreground="Gray" Margin="0,10,0,0" Visibility="Collapsed"/>

            <!-- Público -->
            <TextBlock Text="{x:Static language:Resources._public}" FontSize="28" Margin="0,30,0,10"/>
            <ToggleButton x:Name="PublicToggle" Width="120" Height="60" IsChecked="True" Checked="PublicToggle_Checked" Unchecked="PublicToggle_Unchecked">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Content" Value="OFF"/>
                        <Setter Property="Background" Value="DarkGray"/>
                        <Setter Property="FontSize" Value="24"/>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="ON"/>
                                <Setter Property="Background" Value="LightGreen"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <TextBlock x:Name="PublicMessage" Text="{x:Static language:Resources.public_message}" 
                       FontSize="18" Foreground="Gray" Margin="0,10,0,0" Visibility="Visible"/>
            <TextBlock x:Name="PrivateMessage" Text="{x:Static language:Resources.private_message}" 
                       FontSize="18" Foreground="Gray" Margin="0,10,0,0" Visibility="Collapsed"/>

        </StackPanel>

        <!-- Panel Derecho: multimedia -->
        <Border Grid.Column="1" Background="LightGray" Margin="20" CornerRadius="10" BorderBrush="Gray" BorderThickness="2">
            <Grid>
                <!-- Imagen de ejemplo -->
                <Image Source="/Images/FEI MainPage.png" Stretch="Uniform"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
