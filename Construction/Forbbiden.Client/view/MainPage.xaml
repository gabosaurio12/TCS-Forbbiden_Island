<Page x:Class="Forbbiden.Client.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/exc:\mac\home\documents\uv\5° semestre\tcs\tcs-forbbiden_island\construction\forbbiden.client\view\mainpage.xaml"
      xmlns:local="clr-namespace:Forbbiden.Client.Controls"
      xmlns:language="clr-namespace:Forbbiden.Client.Properties.Langs"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainWindow">
    
    <Page.Background>
        <ImageBrush ImageSource="/Images/FEI MainPage.png" Stretch="Fill"/>
    </Page.Background>
    
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080"
>
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:OutlinedTextBlock Text="FORBIDDEN ISLAND"
                         FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                         FontSize="96"
                         Fill="#5FD733"
                         Stroke="#264D11"
                         StrokeThickness="4"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,20,0,0"/>
                <local:OutlinedTextBlock Text="FEI EDITION"
                         FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                         FontSize="64"
                         Fill="#96FF5D"
                         Stroke="#1B7C00"
                         StrokeThickness="2"
                         HorizontalAlignment="Right"
                         Margin="0,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0"
                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="710,0,0,0">
                <Button x:Name="playButton" Content="{x:Static language:Resources.play}"
                        Width="500" Height="80" Margin="0,10"
                        BorderThickness="5" BorderBrush="Black"
                        FontFamily="pack://application:,,,/Fonts/#Irish Grover" FontSize="30" Foreground="White"
                        Click="PlayButton_Click" Background="#A1A1A1"/>
                <Button x:Name="settingsButton" Content="{x:Static language:Resources.settings}"
                        Width="500" Height="80" Margin="0,10"
                        BorderThickness="5" BorderBrush="Black"
                        FontFamily="pack://application:,,,/Fonts/#Irish Grover" FontSize="30" Foreground="White"
                        Click="SettingsButton_Click" Background="#A1A1A1" />
                <Button x:Name="quitGameButton" Content="{x:Static language:Resources.quit_game}"
                        Width="500" Height="80" Margin="0,10"
                        BorderThickness="5" BorderBrush="Black"
                        FontFamily="pack://application:,,,/Fonts/#Irish Grover" FontSize="30" Foreground="White"
                        Click="QuitGameButton_Click" Background="#A1A1A1" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="txtBkUser" Text="{x:Static language:Resources.guest}"
                           Foreground="White"
                           FontSize="32"
                           TextAlignment="Center"
                           FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                           FontWeight="Bold"
                           Margin="0,0,0,10"
                           Opacity="0.8"/>
                <Grid Width="220" Height="220" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="17*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Fill="Gray" Grid.ColumnSpan="2"/>
                    <Ellipse x:Name="imgAvatar" Margin="5,5,5,5" Grid.ColumnSpan="2">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Images/mach248px.png"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <Button x:Name="profileButton" Content="{x:Static language:Resources.profile}"
                        Width="200" Height="60"
                        FontFamily="pack://application:,,,/Fonts/#Irish Grover" FontSize="30" Foreground="White"
                        BorderThickness="5" BorderBrush="Black"
                        HorizontalAlignment="Center"
                        Click="ProfileButton_Click" Background="#A1A1A1" />
            </StackPanel>

            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="logInButton" Grid.Column="0" Content="{x:Static language:Resources.login_title}" 
                        Width="230" Height="80"
                        HorizontalAlignment="Left" Margin="20"
                        BorderThickness="5" BorderBrush="Black"
                        FontFamily="pack://application:,,,/Fonts/#Irish Grover" FontSize="30" Foreground="White"
                        Click="LogInButton_Click" Background="#A1A1A1" />
            </Grid>
        </Grid>
    </Viewbox>
</Page>
