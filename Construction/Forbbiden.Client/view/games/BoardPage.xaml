<Page x:Class="Forbbiden.Client.view.games.BoardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Forbbiden.Client.view.games"
      xmlns:language="clr-namespace:Forbbiden.Client.Properties.Langs"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Board">

    <Page.Background>
        <ImageBrush ImageSource="/Images/water.png"/>
    </Page.Background>

    <Viewbox Stretch="Uniform">

        <DockPanel>

            <!-- Actions Rigth -->
            <Border DockPanel.Dock="Right" VerticalAlignment="Top" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <StackPanel Orientation="Vertical" Grid.Row="0">
                        <TextBlock Text="{x:Static language:Resources.actions_left}"
                                    HorizontalAlignment="Center"
                                    FontSize="32" Foreground="White"
                                    FontFamily="pack://application:,,,/Fonts/#Irish Grover" />

                        <StackPanel Orientation="Horizontal" >
                            <Image Source="/Images/actionsLeft2.png"
                                    Height="200" Width="200" />
                            <Image Source="/Images/actionsLeft2.png"
                                    Height="200" Width="200" />
                        </StackPanel>
                    </StackPanel>



                    <StackPanel Orientation="Vertical" Grid.Row="1" Margin="0,0,0,0" >
                        <Grid Height="132" Width="404" Margin="0,100,0,0">
                            <Image Source="/Images/boardButtons.png" />
                            <TextBlock Text="{x:Static language:Resources.move_button}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       FontSize="48" Foreground="White"/>
                        </Grid>

                        <Grid Height="132" Width="404" Margin="0,0,0,0">
                            <Image Source="/Images/boardButtons.png" />
                            <TextBlock Text="{x:Static language:Resources.shore_up_button}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       FontSize="48" Foreground="White"/>
                        </Grid>

                        <Grid Height="132" Width="404" Margin="0,0,0,0">
                            <Image Source="/Images/boardButtons.png" />
                            <TextBlock Text="{x:Static language:Resources.capture_button}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       FontSize="48" Foreground="White"/>
                        </Grid>

                    </StackPanel>
                </Grid>

            </Border>


            <!-- Left -->

            <Border DockPanel.Dock="Left" Margin="25,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Players -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Static language:Resources.players}"
                                   FontSize="32" FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                                   Foreground="White" />

                        <Ellipse x:Name="playerOneList" Margin="5,5,5,5" Grid.ColumnSpan="2"
                                 Height="100" Width="100" Stroke="LightGray" StrokeThickness="5">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/avatars/Patronus HD.jpg" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <Ellipse x:Name="playerTwoList" Margin="5,5,5,5" Grid.ColumnSpan="2"
                                 Height="100" Width="100" Stroke="LightGray" StrokeThickness="5">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/avatars/meme-pantene.jpg" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <Ellipse x:Name="playerThreeList" Margin="5,5,5,5" Grid.ColumnSpan="2"
                                 Height="100" Width="100" Stroke="LightGray" StrokeThickness="5">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/avatars/EL ORIGEN DEL PADRINO BIÓNICO.png"  />
                            </Ellipse.Fill>
                        </Ellipse>

                        <Ellipse x:Name="playerFourList" Margin="5,5,5,5" Grid.ColumnSpan="2"
                                 Height="100" Width="100" Stroke="LightGray" StrokeThickness="5">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/avatars/IMG_20191001_171350.jpg" />
                            </Ellipse.Fill>
                        </Ellipse>

                    </StackPanel>

                    <!-- Water level -->
                    <StackPanel Orientation="Vertical" Grid.Row="1">
                        <Image HorizontalAlignment="Left"
                           Height="380" Width="200" 
                           Margin="0,50,0,0"
                           Source="/Images/waterLevel-0.png" />
                        <TextBlock Text="{x:Static language:Resources.water_level}"
                               FontSize="32" Foreground="White"
                               FontFamily="pack://application:,,,/Fonts/#Irish Grover" />
                    </StackPanel>


                    <!-- Chat -->
                    <TextBox x:Name="txtChat" Grid.Row="2"
                         Width="370" Height="180"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="0,120,25,0"
                         Text="Chat..."
                         FontSize="30"
                         FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                         Foreground="Black"
                         Background="#FFD9D9D9"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         Opacity="0.5" />
                </Grid>
            </Border>

            <!-- Center -->

            <Border Margin="0,0,0,0">

                <StackPanel Orientation="Vertical" Margin="0,25,0,0">

                    <!-- Board -->
                    <Grid HorizontalAlignment="Center" Margin="0,0,20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- First row -->
                        <Rectangle Grid.Column="1" Grid.Row="0"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="2" Grid.Row="0"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="3" Grid.Row="0"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>

                        <!-- Second row -->
                        <Rectangle Grid.Column="0" Grid.Row="1"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="1" Grid.Row="1"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="2" Grid.Row="1"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="3" Grid.Row="1"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="4" Grid.Row="1"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>

                        <!-- Third row -->
                        <Rectangle Grid.Column="0" Grid.Row="2"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="1" Grid.Row="2"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="2" Grid.Row="2"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="3" Grid.Row="2"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="4" Grid.Row="2"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>

                        <!-- Fourth row -->
                        <Rectangle Grid.Column="0" Grid.Row="3"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="1" Grid.Row="3"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="2" Grid.Row="3"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="3" Grid.Row="3"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="4" Grid.Row="3"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>

                        <!-- Fifth row -->
                        <Rectangle Grid.Column="1" Grid.Row="4"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="2" Grid.Row="4"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                        <Rectangle Grid.Column="3" Grid.Row="4"
                                    Height="150" Width="150" Margin="10"
                                    Fill="White" Stroke="DarkBlue" StrokeThickness="3" 
                                    MouseEnter="ColorStroke_MouseEnter"
                                    MouseLeave="ColorStroke_MouseLeave"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,200,0,0">
                        <Rectangle
                            Height="200" Width="140" Margin="0,0,0,0"
                            Fill="#D9C790" Stroke="#734714" StrokeThickness="15" />

                        <Rectangle
                            Height="200" Width="140" Margin="60,0,0,0"
                            Fill="#D9C790" Stroke="#734714" StrokeThickness="15" />

                        <Rectangle
                            Height="200" Width="140" Margin="60,0,0,0"
                            Fill="#D9C790" Stroke="#734714" StrokeThickness="15" />

                        <Rectangle
                            Height="200" Width="140" Margin="60,0,0,0"
                            Fill="#D9C790" Stroke="#734714" StrokeThickness="15" />

                        <Rectangle
                            Height="200" Width="140" Margin="60,0,0,0"
                            Fill="#D9C790" Stroke="#734714" StrokeThickness="15" />
                    </StackPanel>

                </StackPanel>

            </Border>

        </DockPanel>

    </Viewbox>
        
</Page>
