<Page x:Class="Forbbiden.Client.View.LeaveMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:language="clr-namespace:Forbbiden.Client.Properties"
      Title="LeaveMenu">
    <Grid Background="#AA000000">
        <Border Width="620"
                Height="620"
                Background="#303873"
                CornerRadius="12"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                BorderBrush="#EFC437"
                BorderThickness="2">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Static language:Resources.leave_menu_title}"
                           FontFamily="{StaticResource IrishGrover}"
                           FontSize="32"
                           Foreground="#EFC437"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,6,0,12"/>

                <!-- Sección de expulsar jugador (solo host) -->
                <Border x:Name="KickSection"
                        Grid.Row="1"
                        Background="#3D4B92"
                        CornerRadius="10"
                        BorderBrush="#EFC437"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{x:Static language:Resources.leave_menu_kick_title}"
                                   FontFamily="{StaticResource IrishGrover}"
                                   FontSize="22"
                                   Foreground="White"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{x:Static language:Resources.leave_menu_kick_desc}"
                                   FontFamily="{StaticResource IrishGrover}"
                                   FontSize="18"
                                   Foreground="#D7DBFF"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>

                        <ComboBox x:Name="KickCombo"
                                  Margin="0,4,0,0"
                                  Height="34"
                                  FontSize="16"/>

                        <TextBlock x:Name="KickEmpty"
                                   Text="{x:Static language:Resources.leave_menu_kick_none}"
                                   FontFamily="{StaticResource IrishGrover}"
                                   FontSize="16"
                                   Foreground="#FFD7A1"
                                   Visibility="Collapsed"
                                   Margin="0,6,0,0"/>

                        <Button x:Name="BtnKickPlayer"
                                Content="{x:Static language:Resources.leave_menu_kick_button}"
                                Width="180" Height="46"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                FontFamily="{StaticResource IrishGrover}"
                                FontSize="18"
                                Foreground="White"
                                Background="#C06D2E"
                                Cursor="Hand"
                                Click="BtnKickPlayer_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="10"
                                            BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="{x:Static language:Resources.leave_menu_message}"
                           FontFamily="{StaticResource IrishGrover}"
                           FontSize="24"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           MaxWidth="440"/>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,4">
                    <Button x:Name="BtnContinue"
                            Content="{x:Static language:Resources.leave_menu_continue}"
                            Width="140" Height="50"
                            FontFamily="{StaticResource IrishGrover}"
                            FontSize="20"
                            Foreground="White"
                            Background="#43C414"
                            Cursor="Hand"
                            Click="BtnContinue_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnLeave"
                            Content="{x:Static language:Resources.leave_menu_leave}"
                            Width="140" Height="50"
                            FontFamily="{StaticResource IrishGrover}"
                            FontSize="20"
                            Foreground="White"
                            Background="#C0392B"
                            Cursor="Hand"
                            Margin="12,0,0,0"
                            Click="BtnLeave_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>