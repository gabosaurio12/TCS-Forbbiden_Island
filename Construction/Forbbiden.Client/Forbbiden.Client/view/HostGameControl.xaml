<UserControl x:Class="Forbbiden.Client.View.HostGameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:language="clr-namespace:Forbbiden.Client.Properties">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ButtonStyle.xaml"/>
                <ResourceDictionary Source="/Styles/ToggleButton.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryColor" Color="#3CB7FF"/>
            <SolidColorBrush x:Key="PrimaryDark" Color="#2894CC"/>
            <SolidColorBrush x:Key="CardBg" Color="#F7FBFF"/>
            <SolidColorBrush x:Key="BorderColor" Color="#D0E7F7"/>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBg}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="16"/>
            </Style>

            <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="MinWidth" Value="300"/>
                <Setter Property="MinHeight" Value="56"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#EEF6FC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel de configuración (columna izquierda) -->
        <Border Grid.Column="0" Margin="20" Style="{StaticResource CardBorderStyle}">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch">

                <TextBlock Text="{x:Static language:Resources.create_room}" 
                           FontSize="30" FontWeight="Bold" Margin="0,0,0,12" Foreground="#0B2F4A"/>

                <TextBlock Text="{x:Static language:Resources.room_name}" FontSize="18" Margin="0,6,0,4" Foreground="#2C3E50"/>
                <TextBox x:Name="txtRoomName"
                         MinWidth="220"
                         FontSize="16"
                         MaxLength="20"
                         ToolTip="Nombre de sala (máx 20 caracteres)"/>

                <StackPanel Orientation="Vertical" Margin="0,16,0,0">
                    <TextBlock Text="{x:Static language:Resources.max_players}" FontSize="18" Margin="0,0,0,6" Foreground="#2C3E50"/>
                    <ComboBox x:Name="PlayerComboBox"
                              MinWidth="180"
                              MinHeight="36"
                              FontSize="16"
                              SelectedIndex="2"
                              SelectionChanged="PlayerComboBox_SelectionChanged">
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Text="{x:Static language:Resources.difficulty}" FontSize="18" Margin="0,16,0,6" Foreground="#2C3E50"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <Button x:Name="NormalButton" Content="{x:Static language:Resources.normal}" 
                            MinWidth="140" MinHeight="48" FontSize="18"
                            Style="{StaticResource ButtonStyle}"
                            Margin="0,0,12,0" Click="NormalButton_Click"/>
                    <Button x:Name="HardButton" Content="{x:Static language:Resources.hard}" 
                            MinWidth="140" MinHeight="48" FontSize="18"
                            Style="{StaticResource ButtonStyle}"
                            Click="HardButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="NormalMessage" Text="{x:Static language:Resources.normal_message}" 
                           FontSize="14" Foreground="Gray" Margin="0,6,0,0" Visibility="Visible"/>
                <TextBlock x:Name="HardMessage" Text="{x:Static language:Resources.hard_message}" 
                           FontSize="14" Foreground="Gray" Margin="0,6,0,0" Visibility="Collapsed"/>

                <TextBlock Text="{x:Static language:Resources.visibility}" FontSize="18" Margin="0,18,0,6" Foreground="#2C3E50"/>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                    <ToggleButton x:Name="PublicToggle"
                                  Width="120" Height="120" 
                                  Style="{StaticResource ToggleStyle}"
                                  IsChecked="True"
                                  Click="PublicToggle_Click" Checked="PublicToggle_Checked"/>
                    <TextBlock x:Name="PublicMessage" Text="{x:Static language:Resources.public_message}" 
                               FontSize="14" Foreground="Gray" Margin="0,8,0,0" HorizontalAlignment="Center" Visibility="Visible"/>
                    <TextBlock x:Name="PrivateMessage" Text="{x:Static language:Resources.private_message}" 
                               FontSize="14" Foreground="Gray" Margin="0,4,0,0" HorizontalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>

                <Button x:Name="PlayButton"
                        Content="{x:Static language:Resources.play}"
                        Margin="0,28,0,0"
                        Style="{StaticResource PlayButtonStyle}"
                        Click="PlayButton_Click"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Imagen decorativa (columna derecha) -->
        <Border Grid.Column="1" Background="White" Margin="20" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5">
            <Grid>
                <Image Source="/Images/FEI MainPage.png" Stretch="Uniform" />
            </Grid>
        </Border>
    </Grid>
</UserControl>