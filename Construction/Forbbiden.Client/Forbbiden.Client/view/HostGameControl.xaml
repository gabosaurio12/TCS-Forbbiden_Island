<UserControl x:Class="Forbbiden.Client.HostGameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:language="clr-namespace:Forbbiden.Client.Properties.Langs">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ButtonStyle.xaml"/>
                <ResourceDictionary Source="/Styles/ToggleButton.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel de configuración (columna izquierda) -->
        <StackPanel Grid.Column="0" Margin="20" VerticalAlignment="Top" HorizontalAlignment="Stretch" >

            <!-- Título -->
            <TextBlock Text="{x:Static language:Resources.create_room}" 
                       FontSize="30" FontWeight="Bold" Margin="0,0,0,12"/>

            <!-- Room name -->
            <TextBlock Text="{x:Static language:Resources.room_name}" FontSize="18" Margin="0,6,0,4"/>
            <TextBox x:Name="txtRoomName"
                     MinWidth="220"
                     FontSize="16"
                     MaxLength="20"
                     ToolTip="Nombre de sala (máx 20 caracteres)"/>

            <!-- Player capacity (selector) -->
            <StackPanel Orientation="Vertical" Margin="0,16,0,0">
                <TextBlock Text="{x:Static language:Resources.max_players}" FontSize="18" Margin="0,0,0,6"/>
                <ComboBox x:Name="PlayerComboBox"
                          MinWidth="180"
                          MinHeight="36"
                          FontSize="16"
                          SelectedIndex="2"
                          SelectionChanged="PlayerComboBox_SelectionChanged">
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                </ComboBox>
            </StackPanel>

            <!-- Dificultad (ahora debajo del selector de jugadores) -->
            <TextBlock Text="{x:Static language:Resources.difficulty}" FontSize="18" Margin="0,16,0,6"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                <Button x:Name="NormalButton" Content="{x:Static language:Resources.normal}" 
                        MinWidth="140" MinHeight="48" FontSize="18"
                        Style="{StaticResource ButtonStyle}"
                        Margin="0,0,12,0" Click="NormalButton_Click"/>
                <Button x:Name="HardButton" Content="{x:Static language:Resources.hard}" 
                        MinWidth="140" MinHeight="48" FontSize="18"
                        Style="{StaticResource ButtonStyle}"
                        Click="HardButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="NormalMessage" Text="{x:Static language:Resources.normal_message}" 
                       FontSize="14" Foreground="Gray" Margin="0,6,0,0" Visibility="Visible"/>
            <TextBlock x:Name="HardMessage" Text="{x:Static language:Resources.hard_message}" 
                       FontSize="14" Foreground="Gray" Margin="0,6,0,0" Visibility="Collapsed"/>

            <!-- Visibilidad: toggle grande con texto debajo -->
            <TextBlock Text="{x:Static language:Resources.visibility}" FontSize="18" Margin="0,18,0,6"/>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="0,0,0,0">
                <ToggleButton x:Name="PublicToggle"
                              Width="120" Height="120" 
                              Style="{StaticResource ToggleStyle}"
                              IsChecked="True"
                              Click="PublicToggle_Click"/>
                <TextBlock x:Name="PublicMessage" Text="{x:Static language:Resources.public_message}" 
                           FontSize="14" Foreground="Gray" Margin="0,8,0,0" HorizontalAlignment="Center" Visibility="Visible"/>
                <TextBlock x:Name="PrivateMessage" Text="{x:Static language:Resources.private_message}" 
                           FontSize="14" Foreground="Gray" Margin="0,4,0,0" HorizontalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Play button -->
            <Button x:Name="PlayButton"
                    Content="{x:Static language:Resources.play}"
                    MinWidth="300" MinHeight="56"
                    Background="Orange"
                    FontSize="20"
                    Margin="0,28,0,0"
                    Click="PlayButton_Click"
                    HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Imagen decorativa (columna derecha) -->
        <Border Grid.Column="1" Background="LightGray" Margin="20" CornerRadius="10" BorderBrush="Gray" BorderThickness="2">
            <Grid>
                <Image Source="/Images/FEI MainPage.png" Stretch="Uniform"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>