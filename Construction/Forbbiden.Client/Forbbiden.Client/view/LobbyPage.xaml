<Page x:Class="Forbbiden.Client.view.LobbyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="LobbyPage">

    <Page.Background>
        <ImageBrush ImageSource="/Images/Sea.png" Stretch="Fill"/>
    </Page.Background>

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">

            <TextBlock x:Name="txtLobbyHour"
                       Text="12:35 AM"
                       FontSize="32"
                       Foreground="White"
                       FontFamily="{StaticResource IrishGrover}"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,20,40,0" Height="80" Width="284"/>

            <!-- Chat histórico (arriba-izq) -->
            <ListBox x:Name="lstChatHistory"
                     Width="420" Height="260"
                     Margin="40,40,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Background="#CC000000"
                     Foreground="White"
                     BorderBrush="#66000000"
                     BorderThickness="1"
                     Padding="8"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <!-- Chat input (abajo-izq) -->
            <TextBox x:Name="txtBxChat"
                     Width="700" Height="110"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="40,0,0,70"
                     Text="Chat..."
                     FontSize="30"
                     FontFamily="{StaticResource IrishGrover}"
                     Foreground="Black"
                     Background="#FFD9D9D9"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     KeyDown="TxtChat_KeyDown"
                     Opacity="0.9"/>

            <Button x:Name="btnReady"
                    Content="Ready"
                    Width="200" Height="60"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,40,40"
                    BorderThickness="5"
                    BorderBrush="Black"
                    Background="#D9D9D9"
                    FontSize="30"
                    FontFamily="{StaticResource IrishGrover}"
                    FontWeight="Bold"
                    Cursor="Hand" Click="BtnReady_Click"/>

            <Image Source="/Images/Boat.png"
                   Width="1100" Height="400"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top" Margin="388,494,0,0"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,50,0,0" Height="250">

                <!-- Player 1 -->
                <StackPanel Margin="20,0">
                    <TextBlock x:Name="txtBkUser1" Text="Player1"
                               FontSize="24" Foreground="White"
                               FontFamily="{StaticResource IrishGrover}"
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Grid Width="150" Height="150">
                        <Ellipse Fill="Gray"/>
                        <Ellipse x:Name="imgAvatar1" Margin="5" StrokeThickness="0">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/defaultAvatar.png"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </StackPanel>

                <!-- Player 2 -->
                <StackPanel Margin="20,0">
                    <TextBlock x:Name="txtBkUser2" Text="Player2"
                               FontSize="24" Foreground="White"
                               FontFamily="{StaticResource IrishGrover}"
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Grid Width="150" Height="150">
                        <Ellipse Fill="LightGray"/>
                        <Ellipse x:Name="imgAvatar2" Margin="5" StrokeThickness="0">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/defaultAvatar.png"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </StackPanel>

                <!-- Player 3 -->
                <StackPanel Margin="20,0">
                    <TextBlock x:Name="txtBkUser3" Text="Player3"
                               FontSize="24" Foreground="White"
                               FontFamily="{StaticResource IrishGrover}"
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Grid Width="150" Height="150">
                        <Ellipse Fill="LightGray"/>
                        <Ellipse x:Name="imgAvatar3" Margin="5" StrokeThickness="0">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/defaultAvatar.png"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </StackPanel>

                <!-- Player 4 -->
                <StackPanel Margin="20,0">
                    <TextBlock x:Name="txtBkUser4" Text="Player4"
                               FontSize="24" Foreground="White"
                               FontFamily="{StaticResource IrishGrover}"
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Grid Width="150" Height="150">
                        <Ellipse Fill="LightGray"/>
                        <Ellipse x:Name="imgAvatar4" Margin="5" StrokeThickness="0">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/defaultAvatar.png"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </StackPanel>
            </StackPanel>

        </Grid>
    </Viewbox>
</Page>