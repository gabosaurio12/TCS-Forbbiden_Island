<Page x:Class="Forbbiden.Client.View.LobbyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:language="clr-namespace:Forbbiden.Client.Properties"
      mc:Ignorable="d"
      Title="LobbyPage">

    <Page.Background>
        <ImageBrush ImageSource="/Images/Sea.png" Stretch="Fill"/>
    </Page.Background>

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">

            <TextBlock x:Name="txtLobbyHour"
                       Text="12:35 AM"
                       FontSize="32"
                       Foreground="White"
                       FontFamily="{StaticResource IrishGrover}"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,20,40,0" Height="80" Width="432"/>
            <StackPanel x:Name="InvitePanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,120,0,0"
                        Visibility="Collapsed">
                <TextBlock Text="{x:Static language:Resources.invite_code_label}"
                           FontSize="24"
                           FontFamily="{StaticResource IrishGrover}"
                           Foreground="White"
                           Margin="0,0,8,0"/>
                <TextBlock x:Name="txtInviteCode"
                           Text="---"
                           FontSize="24"
                           FontFamily="{StaticResource IrishGrover}"
                           Foreground="#EFC437"/>
            </StackPanel>

            <!-- Chat histórico (arriba-izq) -->
            <ListBox x:Name="lstChatHistory"
                     Width="420" Height="260"
                     Margin="40,40,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Background="#CC000000"
                     Foreground="White"
                     BorderBrush="#66000000"
                     BorderThickness="1"
                     Padding="8"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <!-- Chat input con prefijo fijo -->
            <Grid Width="700" Height="110"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="40,0,0,70"
                  Opacity="0.9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#FFD9D9D9"
                        CornerRadius="4"
                        BorderBrush="#66000000"
                        BorderThickness="1"
                        Padding="6,8,6,8"
                        Grid.Column="0">
                    <TextBlock x:Name="txtChatPrefix"
                               Text="{x:Static language:Resources.chat_prefix_placeholder}"
                               FontSize="24"
                               FontFamily="{StaticResource IrishGrover}"
                               Foreground="Black"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBox x:Name="txtChatMessage"
                         Grid.Column="1"
                         FontSize="24"
                         FontFamily="{StaticResource IrishGrover}"
                         Foreground="Black"
                         Background="#FFD9D9D9"
                         BorderBrush="#66000000"
                         BorderThickness="1"
                         Padding="8"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         KeyDown="TxtChatMessage_KeyDown"/>
            </Grid>

            <Button x:Name="btnReady"
                    Content="{x:Static language:Resources.ready_button_ready}"
                    Width="200" Height="60"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,40,40"
                    BorderThickness="5"
                    BorderBrush="Black"
                    Background="#D9D9D9"
                    FontSize="30"
                    FontFamily="{StaticResource IrishGrover}"
                    FontWeight="Bold"
                    Cursor="Hand" Click="BtnReady_Click"/>

            <Image Source="/Images/Boat.png"
                   Width="1100" Height="400"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top" Margin="388,494,0,0"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,50,0,0" Height="250">

                <!-- Player 1 -->
                <StackPanel Margin="20,0">
                    <TextBlock x:Name="txtBkUser1" Text="Player1"
                               FontSize="24" Foreground="White"
                               FontFamily="{StaticResource IrishGrover}"
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Grid Width="150" Height="150">
                        <Ellipse Fill="Gray"/>
                        <Ellipse x:Name="imgAvatar1" Margin="5" StrokeThickness="0">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/defaultAvatar.png"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </StackPanel>

                <!-- Player 2 -->
                <StackPanel Margin="20,0">
                    <TextBlock x:Name="txtBkUser2" Text="Player2"
                               FontSize="24" Foreground="White"
                               FontFamily="{StaticResource IrishGrover}"
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Grid Width="150" Height="150">
                        <Ellipse Fill="LightGray"/>
                        <Ellipse x:Name="imgAvatar2" Margin="5" StrokeThickness="0">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/defaultAvatar.png"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </StackPanel>

                <!-- Player 3 -->
                <StackPanel Margin="20,0">
                    <TextBlock x:Name="txtBkUser3" Text="Player3"
                               FontSize="24" Foreground="White"
                               FontFamily="{StaticResource IrishGrover}"
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Grid Width="150" Height="150">
                        <Ellipse Fill="LightGray"/>
                        <Ellipse x:Name="imgAvatar3" Margin="5" StrokeThickness="0">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/defaultAvatar.png"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </StackPanel>

                <!-- Player 4 -->
                <StackPanel Margin="20,0">
                    <TextBlock x:Name="txtBkUser4" Text="Player4"
                               FontSize="24" Foreground="White"
                               FontFamily="{StaticResource IrishGrover}"
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Grid Width="150" Height="150">
                        <Ellipse Fill="LightGray"/>
                        <Ellipse x:Name="imgAvatar4" Margin="5" StrokeThickness="0">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/defaultAvatar.png"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </StackPanel>
            </StackPanel>

        </Grid>
    </Viewbox>
</Page>