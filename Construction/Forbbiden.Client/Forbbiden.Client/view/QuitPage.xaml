<Page x:Class="Forbbiden.Client.view.QuitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Forbbiden.Client.view"
      xmlns:language="clr-namespace:Forbbiden.Client.Properties.Langs"
      mc:Ignorable="d" 
      Title="QuitPage">

    <Page.Background>
        <ImageBrush ImageSource="/Images/FEI MainPage3.png" Stretch="Fill"/>
    </Page.Background>

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Upper bar -->
            <DockPanel Grid.Row="0" Background="#0F1945" LastChildFill="True">
                <Button x:Name="backButton"
                    Content="&lt;"
                    Width="100" Height="100"
                    FontSize="40"
                    FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                    BorderThickness="5" BorderBrush="#FFB7B7B7"
                    Background="White"
                    Foreground="Black"
                    Margin="20,0,0,0"
                    Cursor="Hand"
                    DockPanel.Dock="Left"
                    Click="BackButton_Click"/>

                <TextBlock Text="{x:Static language:Resources.quit_game}"
                       FontSize="60"
                       FontWeight="Bold"
                       Foreground="White"
                       FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
            </DockPanel>

            <!-- Language Buttons -->
            <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Orientation="Vertical">

                <Button x:Name="quitButton"
                    Content="{x:Static language:Resources.quit_game}"
                    Width="500" Height="80"
                    BorderThickness="5" BorderBrush="#FFB7B7B7"
                    FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                    FontSize="30"
                    Background="LightGray"
                    Foreground="Black"
                    Cursor="Hand"
                    Click="QuitButton_Click"/>

                <Button x:Name="logOutButton"
                    Content="{x:Static language:Resources.logout}"
                    Width="500" Height="80"
                    BorderThickness="5" BorderBrush="#FFB7B7B7"
                    FontFamily="pack://application:,,,/Fonts/#Irish Grover"
                    FontSize="30"
                    Background="LightGray"
                    Foreground="Black"
                    Cursor="Hand"
                    Click="LogOutButton_Click"/>

            </StackPanel>

        </Grid>
    </Viewbox>
</Page>
