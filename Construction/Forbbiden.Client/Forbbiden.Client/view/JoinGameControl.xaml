<UserControl x:Class="Forbbiden.Client.view.JoinGameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:language="clr-namespace:Forbbiden.Client.Properties.Langs"
             Background="LightGray">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Buscador + Actualizar -->
        <Border Background="White" CornerRadius="8" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Height="40"
                         FontSize="16"
                         VerticalContentAlignment="Center"
                         Padding="8"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="{x:Static language:Resources.search_placeholder}" />

                <!-- Botón Actualizar -->
                <Button Grid.Column="1"
                        x:Name="BtnRefresh"
                        Content="{x:Static language:Resources.refresh}"
                        Width="110"
                        Height="40"
                        Margin="8,0,8,0"
                        VerticalAlignment="Center"
                        Click="RefreshButton_Click"
                        Style="{StaticResource ButtonStyle}" />

                <!-- (se mantiene la búsqueda por presionar) -->
            </Grid>
        </Border>

        <!-- Lista de partidas -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MatchList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F8F8F8"
                                    Margin="8"
                                    CornerRadius="10"
                                    Padding="16"
                                    BorderBrush="#DDD"
                                    BorderThickness="1" Height="120">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Información principal -->
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding RoomName}" FontSize="20" FontWeight="Bold" Foreground="#222"/>
                                        <TextBlock FontSize="13" Foreground="Gray">
                                            <TextBlock.Inlines>
                                                <Run Text="Host: " Foreground="Gray"/>
                                                <Run Text="{Binding HostName}" Foreground="#333" FontWeight="SemiBold"/>
                                            </TextBlock.Inlines>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Información secundaria -->
                                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PlayersInfo}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Difficulty}" FontSize="14" Foreground="Gray" Margin="0,0,8,0"/>
                                            <TextBlock Text="•" Foreground="Gray" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding VisibilityText}" FontSize="14" Foreground="{Binding VisibilityColor}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Acción: icono + botón Entrar -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                                        <Image Width="28" Height="28" Source="{Binding LockIcon}" Margin="0,0,12,0"/>
                                        <Button Content=">"
                                                Width="72"
                                                Height="72"
                                                FontSize="36"
                                                FontWeight="Bold"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource ButtonStyle}"
                                                Click="JoinButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>