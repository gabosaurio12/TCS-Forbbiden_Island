<UserControl x:Class="Forbbiden.Client.view.JoinGameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:language="clr-namespace:Forbbiden.Client.Properties.Langs"
             Background="LightGray">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Buscador -->
        <Border Background="White" CornerRadius="8" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid Height="50">
                <TextBox x:Name="SearchBox"
                         Width="250"
                         Height="40"
                         FontSize="18"
                         VerticalContentAlignment="Center"
                         Padding="5"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Search by Room..."
                           Foreground="Gray"
                           FontStyle="Italic"
                           FontSize="16"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="Visible"/>
                <Button Content="🔍"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Right"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Click="SearchButton_Click"
                        Style="{StaticResource ButtonStyle}"/>
            </Grid>
        </Border>

        <!-- Lista de partidas -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MatchList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F0F0F0"
                                    Margin="5"
                                    CornerRadius="8"
                                    Padding="10"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Información principal -->
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding RoomName}" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding HostName}" FontSize="18"/>
                                    </StackPanel>

                                    <!-- Información secundaria -->
                                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PlayersInfo}" FontSize="18"/>
                                        <TextBlock Text="{Binding Difficulty}" FontSize="16" Foreground="Gray"/>
                                    </StackPanel>

                                    <!-- Iconos y acción -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Image Width="24" Height="24" Source="{Binding LockIcon}" Margin="0,0,10,0"/>
                                        <Button Content=">" Width="40" Height="40" FontSize="20"
                                                Style="{StaticResource ButtonStyle}"
                                                Click="JoinButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>