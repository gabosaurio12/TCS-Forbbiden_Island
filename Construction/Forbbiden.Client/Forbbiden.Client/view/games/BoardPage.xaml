<Page x:Class="Forbbiden.Client.View.Games.BoardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Forbbiden.Client.View.Games"
      xmlns:controls="clr-namespace:Forbbiden.Client.View.Games;assembly=Forbbiden.Client"
      xmlns:language="clr-namespace:Forbbiden.Client.Properties"
      mc:Ignorable="d" 
      Title="Board">

    <Grid>
        <Image x:Name="gifBackground"
                Stretch="UniformToFill"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Panel.ZIndex="-1"/>

        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <Grid x:Name="mainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                

                <!-- Left -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Stacks and water level -->
                    <Grid Grid.Column="0" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Stacks -->

                        <StackPanel x:Name="stacks" Orientation="Vertical"
                            HorizontalAlignment="Left" Grid.Row="0" Margin="20,20,0,0">
                            <!-- Treasure stack -->
                            <TextBlock Text="{x:Static language:Resources.treasures_saved}"
                                Margin="0,0,0,0"
                                FontSize="32" FontFamily="{StaticResource IrishGrover}"
                                Foreground="White" />

                            <StackPanel x:Name="treasuresSavedStack" Orientation="Vertical"
                                        Height="200">
                                <StackPanel Orientation="Horizontal"
                                            Background="#778899">
                                    <Image  HorizontalAlignment="Left"
                                            x:Name="cleanCodeImage"
                                            Height="40" Margin="5"
                                            Source="/Images/cards/treasure1bw.png"/>
                                    <TextBlock Text="{x:Static language:Resources.clean_code_name}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               FontSize="28" Foreground="White"
                                               FontFamily="{StaticResource IrishGrover}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Background="#778899">
                                    <Image HorizontalAlignment="Left"
                                           x:Name="cubicleKeysImage"
                                           Height="40" Margin="5"
                                           Source="/Images/cards/treasure2bw.png"/>
                                    <TextBlock Text="{x:Static language:Resources.cubicle_keys_name}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               FontSize="28" Foreground="White"
                                               FontFamily="{StaticResource IrishGrover}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Background="#778899">
                                    <Image HorizontalAlignment="Left"
                                           x:Name="lucioImage"
                                           Height="40" Margin="5"
                                           Source="/Images/cards/treasure3bw.png"/>
                                    <TextBlock Text="{x:Static language:Resources.lucio_name}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               FontSize="28" Foreground="White"
                                               FontFamily="{StaticResource IrishGrover}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Background="#778899">
                                    <Image HorizontalAlignment="Left"
                                           x:Name="parkingCardImage"
                                           Height="40" Margin="5"
                                           Source="/Images/cards/treasure4bw.png"/>
                                    <TextBlock Text="{x:Static language:Resources.parking_card_name}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               FontSize="28" Foreground="White"
                                               FontFamily="{StaticResource IrishGrover}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Water level -->
                        <StackPanel Orientation="Vertical" Grid.Row="1" Margin="20,20,0,0">
                            <Image x:Name="waterLevel" HorizontalAlignment="Left"
                            Height="400" Width="250" 
                            Margin="0,20,0,0"
                            Source="/Images/board/waterLevel-0.png" />
                            <TextBlock Text="{x:Static language:Resources.water_level}"
                            FontSize="32" Foreground="White"
                            FontFamily="{StaticResource IrishGrover}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Chat -->
                <TextBox x:Name="txtChat" Grid.Row="2" Grid.Column="0"
                        Width="370" Height="93"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="20,0,0,0"
                        Text="Chat..."
                        FontSize="30"
                        FontFamily="{StaticResource IrishGrover}"
                        Foreground="Black"
                        Background="#FFD9D9D9"
                        TextWrapping="Wrap"
                        AcceptsReturn="False"
                        Opacity="0.5" />

                <!-- Actions left -->
                <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="2" >
                    <TextBlock Text="{x:Static language:Resources.actions_left}"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        FontSize="40" Foreground="White"
                        FontFamily="{StaticResource IrishGrover}" />

                    <StackPanel x:Name="actionsRemainingStack"
                                Height="145"
                                Orientation="Horizontal" HorizontalAlignment="Center" >
                        <Image Source="/Images/board/actionsLeft.png"
                               Height="133" Width="133" />
                        <Image Source="/Images/board/actionsLeft.png"
                               Height="133" Width="133"/>
                        <Image Source="/Images/board/actionsLeft.png"
                               Height="133" Width="133"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Orientation="Vertical" 
                                Grid.Row="1" Grid.Column="2"
                                Height="570" Width="400"
                                HorizontalAlignment="Right" Margin="0" >

                        <Grid Height="130" Width="350" Margin="0"
                              MouseEnter="Moves_MouseEnter"
                              MouseLeave="Moves_MouseLeave"
                              MouseLeftButtonDown="Move_MouseLeftButtonDown"
                              HorizontalAlignment="Right">
                            <Image Source="/Images/board/boardButtons.png" Cursor="Hand" />
                            <TextBlock Text="{x:Static language:Resources.move_button}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="40,0,0,0"
                                       FontFamily="{StaticResource IrishGrover}"
                                       FontSize="44" Foreground="White"
                                       Cursor="Hand"/>
                        </Grid>

                        <Grid Height="130" Width="350" Margin="0"
                              MouseEnter="Moves_MouseEnter"
                              MouseLeave="Moves_MouseLeave"
                              HorizontalAlignment="Right"
                              MouseLeftButtonDown="Shore_MouseLeftButtonDown">
                            <Image Source="/Images/board/boardButtons.png" Cursor="Hand" />
                            <TextBlock Text="{x:Static language:Resources.shore_up_button}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="40,0,0,0"
                                       FontFamily="{StaticResource IrishGrover}"
                                       FontSize="44" Foreground="White"
                                       Cursor="Hand"/>
                        </Grid>

                        <Grid Height="130" Width="350" Margin="0"
                              MouseEnter="Moves_MouseEnter"
                              MouseLeave="Moves_MouseLeave"
                              HorizontalAlignment="Right"
                              MouseLeftButtonDown="CaptureTreasure_MouseLeftButtonDown">
                            <Image Source="/Images/board/boardButtons.png" Cursor="Hand" />
                            <TextBlock Text="{x:Static language:Resources.capture_button}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Margin="0,0,20,0"
                                       FontFamily="{StaticResource IrishGrover}"
                                       FontSize="35" Foreground="White"
                                       Cursor="Hand"/>
                        </Grid>

                        <Grid Height="130" Width="350" Margin="0"
                              MouseEnter="Moves_MouseEnter"
                              MouseLeave="Moves_MouseLeave"
                              HorizontalAlignment="Right"
                              MouseLeftButtonDown="UseTreasureCard_MouseLeftButtonDown">
                            <Image Source="/Images/board/boardButtons.png" Cursor="Hand" />
                            <TextBlock Text="{x:Static language:Resources.use_card}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="40,0,0,0"
                                       FontFamily="{StaticResource IrishGrover}"
                                       FontSize="44" Foreground="White"
                                       Cursor="Hand"/>
                        </Grid>
                        
                    </StackPanel>
                </StackPanel>

                <!-- Player Cards Stack -->
                <StackPanel x:Name="cardStack" Orientation="Horizontal" Grid.Row="1" Grid.Column="1"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0">
                    
                </StackPanel>

                <Button x:Name="endTurnButton"
                        Grid.Row="1" Grid.Column="2"
                        Height="80" Width="250"
                        BorderBrush="Black"
                        BorderThickness="8"
                        Content="{x:Static language:Resources.finish_turn}"
                        FontFamily="{StaticResource IrishGrover}"
                        FontSize="28"
                        Cursor="Hand"
                        Click="EndTurnButton_Click"
                        />
            </Grid>
        </Viewbox>
    </Grid>
</Page>
