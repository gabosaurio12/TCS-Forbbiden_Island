<UserControl x:Class="Forbbiden.Client.view.games.UserControlCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Forbbiden.Client.view.games"
             mc:Ignorable="d" 
             d:DesignHeight="170" d:DesignWidth="140">
    <Grid
        MouseEnter="Card_MouseEnter"
        MouseLeave="Card_MouseLeave" >
        <Rectangle
            Height="170" Width="140" Margin="0,0,0,0"
            Fill="#734714" StrokeThickness="10"
            Cursor="Hand"/>

        <Image x:Name="cardImage"
               Height="150" Width="120"
               Stretch="UniformToFill" />
    </Grid>
</UserControl>
