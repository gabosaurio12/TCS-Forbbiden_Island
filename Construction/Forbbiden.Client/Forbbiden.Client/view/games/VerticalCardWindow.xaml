<Window x:Class="Forbbiden.Client.view.games.VerticalCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Forbbiden.Client.view.games"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="VerticalCardWindow" Height="300" Width="270">
    
    <Grid x:Name="cardGrid">
        <Rectangle x:Name="cardRectangle" Height="170" Width="140" />
    </Grid>
</Window>
