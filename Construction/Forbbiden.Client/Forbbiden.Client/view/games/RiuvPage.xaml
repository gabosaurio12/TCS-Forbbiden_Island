<Page x:Class="Forbbiden.Client.view.games.RiuvPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="RiuvPage">

    <Page.Background>
        <ImageBrush ImageSource="/Images/Mundo.png" Stretch="Fill" Opacity="0.95"/>
    </Page.Background>

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">

            <!-- Encabezado -->
            <TextBlock Text="RIUV GAME"
                       FontSize="48"
                       FontWeight="Bold"
                       FontFamily="{StaticResource IrishGrover}"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,20,0,0"/>

            <!-- Temporizador -->
            <TextBlock x:Name="txtTimer"
                       Text="00:10"
                       FontSize="56"
                       FontWeight="Bold"
                       FontFamily="{StaticResource IrishGrover}"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,100,0,0"/>

            <!-- Jugadores -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,443,0,0"
                        Height="377">

                <!-- === Jugador 1 === -->
                <Grid Width="180" Margin="80,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tecla -->
                    <Border x:Name="borderKey1"
                            Grid.Row="0"
                            Background="#DDD"
                            BorderBrush="Black"
                            BorderThickness="5"
                            Width="60" Height="60"
                            CornerRadius="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="txtKey1"
                                   Text="?"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Avatar -->
                    <Grid Grid.Row="1" Width="180" Height="180">
                        <Ellipse Fill="Gray"/>
                        <Ellipse x:Name="imgAvatar1" Margin="5">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/defaultAvatar.png"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <!-- Nombre -->
                    <TextBlock x:Name="txtName1"
                               Grid.Row="2"
                               Text="Player 1"
                               FontSize="24"
                               Foreground="White"
                               FontFamily="{StaticResource IrishGrover}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </Grid>

                <!-- === Jugador 2 === -->
                <Grid Width="180" Margin="80,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tecla -->
                    <Border x:Name="borderKey2"
                            Grid.Row="0"
                            Background="#DDD"
                            BorderBrush="Black"
                            BorderThickness="5"
                            Width="60" Height="60"
                            CornerRadius="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="txtKey2"
                                   Text="?"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Avatar -->
                    <Grid Grid.Row="1" Width="180" Height="180">
                        <Ellipse Fill="LightGray"/>
                        <Ellipse x:Name="imgAvatar2" Margin="5">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/defaultAvatar.png"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <!-- Nombre -->
                    <TextBlock x:Name="txtName2"
                               Grid.Row="2"
                               Text="Player 2"
                               FontSize="24"
                               Foreground="White"
                               FontFamily="{StaticResource IrishGrover}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </Grid>

                <!-- === Jugador 3 === -->
                <Grid Width="180" Margin="80,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tecla -->
                    <Border x:Name="borderKey3"
                            Grid.Row="0"
                            Background="#DDD"
                            BorderBrush="Black"
                            BorderThickness="5"
                            Width="60" Height="60"
                            CornerRadius="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="txtKey3"
                                   Text="?"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Avatar -->
                    <Grid Grid.Row="1" Width="180" Height="180">
                        <Ellipse Fill="LightGray"/>
                        <Ellipse x:Name="imgAvatar3" Margin="5">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/defaultAvatar.png"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <!-- Nombre -->
                    <TextBlock x:Name="txtName3"
                               Grid.Row="2"
                               Text="Player 3"
                               FontSize="24"
                               Foreground="White"
                               FontFamily="{StaticResource IrishGrover}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </Grid>

                <!-- === Jugador 4 === -->
                <Grid Width="180" Margin="80,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tecla -->
                    <Border x:Name="borderKey4"
                            Grid.Row="0"
                            Background="#DDD"
                            BorderBrush="Black"
                            BorderThickness="5"
                            Width="60" Height="60"
                            CornerRadius="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="txtKey4"
                                   Text="?"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Avatar -->
                    <Grid Grid.Row="1" Width="180" Height="180">
                        <Ellipse Fill="LightGray"/>
                        <Ellipse x:Name="imgAvatar4" Margin="5">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/defaultAvatar.png"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <!-- Nombre -->
                    <TextBlock x:Name="txtName4"
                               Grid.Row="2"
                               Text="Player 4"
                               FontSize="24"
                               Foreground="White"
                               FontFamily="{StaticResource IrishGrover}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </Grid>

            </StackPanel>
        </Grid>
    </Viewbox>
</Page>
