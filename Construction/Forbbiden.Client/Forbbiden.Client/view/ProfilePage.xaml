<Page x:Class="Forbbiden.Client.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Forbbiden.Client"
      xmlns:language="clr-namespace:Forbbiden.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Profile Page">

    <Page.Resources>
        <!-- Menos azul, tonos teal/menta -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#6EC6B7"/>
        <SolidColorBrush x:Key="PrimaryDark" Color="#4FA193"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#6BDC42"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FFCB2F"/>
        <SolidColorBrush x:Key="CardBg" Color="#F7FBFF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#D0E7F7"/>

        <DropShadowEffect x:Key="CardShadow"
                          Color="#55000000"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Opacity="0.6"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource IrishGrover}"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontFamily" Value="{StaticResource IrishGrover}"/>
            <Setter Property="Background" Value="{StaticResource PrimaryDark}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="410"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
    </Page.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080" Background="#EEF6FC">
            <Grid.RowDefinitions>
                <RowDefinition Height="125"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Background="{StaticResource PrimaryColor}" LastChildFill="True" Margin="0,0,0,8">
                <Button Content="⟵"
                        Style="{StaticResource AppBarButtonStyle}"
                        Margin="12"
                        DockPanel.Dock="Left"
                        Click="BtnDiscard_Click"/>
                <TextBlock Text="{x:Static language:Resources.profile}"
                           FontSize="56"
                           FontFamily="{StaticResource IrishGrover}"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,30,0"
                           HorizontalAlignment="Center"/>
            </DockPanel>

            <Grid Grid.Row="1" Margin="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource CardBg}"
                        CornerRadius="16"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1.5"
                        Padding="30"
                        Margin="0,0,20,0"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="imgAvatar"
                                 Height="260" Width="260"
                                 Fill="#D9D9D9"
                                 Stroke="{StaticResource PrimaryColor}"
                                 StrokeThickness="4"
                                 Margin="0,10,0,20"/>
                        <TextBlock x:Name="txtBkAvatarName"
                                   Text="{x:Static language:Resources.guest}"
                                   FontSize="48"
                                   FontFamily="{StaticResource IrishGrover}"
                                   Foreground="#2C3E50"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>
                        <TextBlock Text="{x:Static language:Resources.avatar_explanation}"
                                   FontSize="18"
                                   FontFamily="Segoe UI"
                                   Foreground="#566573"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"
                                   Width="280"/>
                        <Button x:Name="btnAvatar"
                                Content="{x:Static language:Resources.upload_avatar}"
                                Width="240" Height="64"
                                FontFamily="{StaticResource IrishGrover}"
                                FontSize="22"
                                Background="{StaticResource PrimaryColor}"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="BtnUploadAvatar_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource CardBg}"
                        CornerRadius="16"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1.5"
                        Padding="30"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" Margin="0,8,16,0">
                            <TextBlock x:Name="txtBkUsername" Text="{x:Static language:Resources.username}" FontSize="32" FontFamily="{StaticResource IrishGrover}" Foreground="#2C3E50" Margin="0,10,0,10"/>
                            <TextBlock x:Name="txtBkName" Text="{x:Static language:Resources.name}" FontSize="32" FontFamily="{StaticResource IrishGrover}" Foreground="#2C3E50" Margin="0,10,0,10"/>
                            <TextBlock x:Name="txtBkEmail" Text="{x:Static language:Resources.email}" FontSize="32" FontFamily="{StaticResource IrishGrover}" Foreground="#2C3E50" Margin="0,10,0,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" Margin="0,8,0,0">
                            <TextBox x:Name="txtBxUsername" Style="{StaticResource InputTextBoxStyle}" Margin="0,10,0,10"/>
                            <TextBox x:Name="txtBxName" Style="{StaticResource InputTextBoxStyle}" Margin="0,10,0,10"/>
                            <TextBox x:Name="txtBxEmail" Style="{StaticResource InputTextBoxStyle}" Margin="0,10,0,10"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,8,20,8" VerticalAlignment="Center">
                                <Image Source="/Images/discord.png" Width="64" Height="64" Margin="0,0,12,0"/>
                                <TextBox x:Name="txtBxDiscord" Style="{StaticResource InputTextBoxStyle}" Width="280"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,8" VerticalAlignment="Center">
                                <Image Source="/Images/x.png" Width="64" Height="64" Margin="0,0,12,0"/>
                                <TextBox x:Name="txtBxX" Style="{StaticResource InputTextBoxStyle}" Width="280"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,8,20,8" VerticalAlignment="Center">
                                <Image Source="/Images/instagram.png" Width="64" Height="64" Margin="0,0,12,0"/>
                                <TextBox x:Name="txtBxInstagram" Style="{StaticResource InputTextBoxStyle}" Width="280"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,8" VerticalAlignment="Center">
                                <Image Source="/Images/facebook.png" Width="64" Height="64" Margin="0,0,12,0"/>
                                <TextBox x:Name="txtBxFacebook" Style="{StaticResource InputTextBoxStyle}" Width="280"/>
                            </StackPanel>
                        </Grid>

                        <!-- Botones -->
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0">
                            <Button x:Name="btnSave"
                                    Content="{x:Static language:Resources.save_changes}"
                                    Width="280" Height="90"
                                    Background="{StaticResource PrimaryColor}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Margin="0,0,12,0"
                                    Click="BtnSave_Click"/>
                            <Button x:Name="btnDiscard"
                                    Content="{x:Static language:Resources.discard_changes}"
                                    Width="280" Height="90"
                                    Background="{StaticResource AccentYellow}"
                                    Foreground="#2C3E50"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Margin="0,0,12,0"
                                    Click="BtnDiscard_Click"/>
                            <!-- Nuevo botón cambiar contraseña -->
                            <Button x:Name="btnChangePassword"
                                    Content="{x:Static language:Resources.change_password}"
                                    Width="280" Height="90"
                                    Background="{StaticResource PrimaryDark}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="BtnDiscard_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</Page>