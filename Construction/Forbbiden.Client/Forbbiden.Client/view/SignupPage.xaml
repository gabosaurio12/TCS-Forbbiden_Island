<Page x:Class="Forbbiden.Client.SignupPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Forbbiden.Client"
      xmlns:language ="clr-namespace:Forbbiden.Client.Properties.Langs"
        mc:Ignorable="d"
        Title="SignupPage" >

    <Page.Background>
        <ImageBrush ImageSource="/Images/FEI MainPage3.png" Stretch="Fill"/>
    </Page.Background>

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Background="#0F1945" LastChildFill="True" >
                <Button x:Name="backButton"
                Content="&lt;"
                Width="100" Height="100"
                FontSize="40"
                FontFamily="{StaticResource IrishGrover}"
                BorderThickness="5" BorderBrush="#FFB7B7B7"
                Background="White"
                Foreground="Black"
                Margin="20,0,0,0"
                Cursor="Hand"
                DockPanel.Dock="Left"
                Click="BackButton_Click"/>

                <!-- Title -->
                <TextBlock Text="{x:Static language:Resources.signup_title}"
                   FontSize="60"
                   Foreground="White"
                   FontFamily="{StaticResource IrishGrover}"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>
            </DockPanel>

            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- User -->
                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,5,0,0">
                    <TextBlock x:Name="txtBkUsername" Text="{x:Static language:Resources.username}"
                               HorizontalAlignment="Left" Foreground="White"
                               FontSize="40" FontFamily="{StaticResource IrishGrover}" />
                    <TextBox x:Name="txtBxUsername" Height="35" Width="400"
                             FontFamily="{StaticResource IrishGrover}"
                             Margin="0,5" FontSize="24" />
                </StackPanel>

                <!-- Email -->
                <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,5,0,0">
                    <TextBlock x:Name="txtBkEmail" Text="{x:Static language:Resources.email}"
                               HorizontalAlignment="Left" Foreground="White"
                               FontSize="40" FontFamily="{StaticResource IrishGrover}" />
                    <TextBox x:Name="txtBxEmail" Height="35" Width="400" Margin="0,5" FontSize="24"
                             FontFamily="{StaticResource IrishGrover}"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,5,0,0">
                    <TextBlock x:Name="txtBkPassword" Text="{x:Static language:Resources.password}"
                               HorizontalAlignment="Left" Foreground="White"
                               FontSize="40" FontFamily="{StaticResource IrishGrover}" />
                    <TextBox x:Name="txtBxPassword" Height="35" Width="400" Margin="0,5"
                             FontFamily="{StaticResource IrishGrover}"
                             FontSize="24" />
                </StackPanel>

                <!-- Register Button -->
                <StackPanel Grid.Row="4" Orientation="Vertical"
                HorizontalAlignment="Center" Margin="0,15,0,0">
                    <Button x:Name="signupButton" Content="{x:Static language:Resources.signup_button}" 
                        Height="50" Width="175" Background="#39B349" 
                        Foreground="White" FontSize="25"
                        FontFamily="{StaticResource IrishGrover}"
                        Click="SignupButton_Click" Margin="0,0,0,0"/>
                    <Label Content="{x:Static language:Resources.login_title}" Margin="0,5,0,0" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" 
                        MouseDown="Login_MouseDown" Cursor="Hand" FontFamily="{StaticResource IrishGrover}"
                        Foreground="White" FontSize="25" />
                </StackPanel>

            </Grid>

            <Image Source="/Images/codebackground.png" Grid.Row="1" Margin="1296,283,171,379" />
            <Image x:Name="bossImage" Source="/Images/boss.png" HorizontalAlignment="Left" Height="292" 
                   Margin="1532,244,0,0" Grid.Row="1" VerticalAlignment="Top" Width="312" RenderTransformOrigin="0.652,0.965"/>
            <TextBlock x:Name="txtBkBoss"
               Text="{x:Static language:Resources.bossLogin}"
               HorizontalAlignment="Left" Margin="1320,325,0,0"
               Grid.Row="1" TextWrapping="Wrap"
               VerticalAlignment="Top" Height="187" Width="280" 
               FontSize="32" Foreground="Wheat"
               FontFamily="Consolas" />

        </Grid>
    </Viewbox>
</Page>