<Window x:Class="Forbbiden.Client.View.Info.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Forbbiden.Client.View.Info"
        mc:Ignorable="d"
        Title="NotificationWindow" Height="400" Width="700"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Background="#303873">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- Upper bar -->
        <Grid Grid.Row="0" Background="#EFC437">
            <TextBlock x:Name="titletxtBk" Foreground="Black"
                       FontFamily="{StaticResource IrishGrover}"
                       FontSize="48"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Message -->
        <Grid Grid.Row="1" >
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="130">
                <TextBlock x:Name="messagetxtBk" Foreground="White"
                           FontFamily="{StaticResource IrishGrover}"
                           FontSize="38"
                           MaxWidth="620"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ScrollViewer>
            
        </Grid>

        <!-- Button -->
        <Grid Grid.Row="2" >
            <Button x:Name="okButton"
                    Content="Ok"
                    Width="120" Height="60"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,50,30"
                    Foreground="White" Background="#43C414"
                    FontFamily="{StaticResource IrishGrover}"
                    FontSize="32"
                    Cursor="Hand"
                    Click="OkButton_Click" >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                    CornerRadius="15"
                                    BorderThickness="0" >
                            <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
        
    </Grid>
</Window>
