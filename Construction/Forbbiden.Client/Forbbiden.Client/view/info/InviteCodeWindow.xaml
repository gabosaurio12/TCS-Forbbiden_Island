<Window x:Class="Forbbiden.Client.View.info.InviteCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:language="clr-namespace:Forbbiden.Client.Properties"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Width="400" Height="220" Background="#303873">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Static language:Resources.invite_code_title}"
                   FontFamily="{StaticResource IrishGrover}"
                   FontSize="32"
                   Foreground="White"
                   HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Margin="0,20,0,20" HorizontalAlignment="Center">
            <TextBlock Text="{x:Static language:Resources.invite_code_prompt}"
                       FontFamily="{StaticResource IrishGrover}"
                       FontSize="18"
                       Foreground="#EFC437"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>
            <TextBox x:Name="codeTextBox"
                     Width="220" Height="48"
                     FontFamily="{StaticResource IrishGrover}"
                     FontSize="28"
                     MaxLength="10"
                     HorizontalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="{x:Static language:Resources.cancel}"
                    Width="120" Height="48"
                    Background="#C41414" Foreground="White"
                    FontFamily="{StaticResource IrishGrover}" FontSize="20"
                    Margin="0,0,12,0"
                    Click="CancelButton_Click"/>
            <Button Content="{x:Static language:Resources.verify}"
                    Width="120" Height="48"
                    Background="#43C414" Foreground="White"
                    FontFamily="{StaticResource IrishGrover}" FontSize="20"
                    Click="VerifyButton_Click"/>
        </StackPanel>
    </Grid>
</Window>