<Page x:Class="Forbbiden.Client.View.FriendProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Forbbiden.Client"
      xmlns:language="clr-namespace:Forbbiden.Client.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="FriendProfilePage">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#3CB7FF"/>
        <SolidColorBrush x:Key="PrimaryDark" Color="#2894CC"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#6BDC42"/>
        <SolidColorBrush x:Key="CardBg" Color="#F7FBFF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#D0E7F7"/>

        <DropShadowEffect x:Key="CardShadow"
                          Color="#55000000"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Opacity="0.6"/>

        <Style x:Key="AppBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontFamily" Value="{StaticResource IrishGrover}"/>
            <Setter Property="Background" Value="{StaticResource PrimaryDark}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080" Background="#EEF6FC">
            <Grid.RowDefinitions>
                <RowDefinition Height="125"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Upper bar -->
            <DockPanel Grid.Row="0" Background="{StaticResource PrimaryColor}" LastChildFill="True" Margin="0,0,0,8">
                <Button Content="⟵"
                        Style="{StaticResource AppBarButtonStyle}"
                        Margin="12"
                        DockPanel.Dock="Left"
                        Click="AcceptBtn_Click"/>
                <TextBlock Text="{x:Static language:Resources.profile}"
                           FontSize="56"
                           FontFamily="{StaticResource IrishGrover}"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,30,0"
                           HorizontalAlignment="Center"/>
            </DockPanel>

            <Grid Grid.Row="1" Margin="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left panel: avatar -->
                <Border Grid.Column="0"
                        Background="{StaticResource CardBg}"
                        CornerRadius="16"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1.5"
                        Padding="30"
                        Margin="0,0,215,0"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="imgAvatar"
                                 Height="260" Width="260"
                                 Fill="#D9D9D9"
                                 Stroke="{StaticResource PrimaryColor}"
                                 StrokeThickness="4"
                                 Margin="0,10,0,20"/>
                        <TextBlock x:Name="txtBkAvatarName"
                                   Text="{x:Static language:Resources.guest}"
                                   FontSize="48"
                                   FontFamily="{StaticResource IrishGrover}"
                                   Foreground="#2C3E50"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>
                    </StackPanel>
                </Border>

                <!-- Right panel: info -->
                <Border
                        Background="{StaticResource CardBg}"
                        CornerRadius="16"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1.5"
                        Padding="30"
                        Effect="{StaticResource CardShadow}" Grid.ColumnSpan="2" Margin="687,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Labels -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" Margin="0,8,16,0">
                            <TextBlock x:Name="txtBkTitleUsername" Text="{x:Static language:Resources.username}" FontSize="32" FontFamily="{StaticResource IrishGrover}" Foreground="#2C3E50" Margin="0,10,0,10"/>
                            <TextBlock x:Name="txtBkTitleName" Text="{x:Static language:Resources.name}" FontSize="32" FontFamily="{StaticResource IrishGrover}" Foreground="#2C3E50" Margin="0,10,0,10"/>
                            <TextBlock x:Name="txtBkTitleEmail" Text="{x:Static language:Resources.email}" FontSize="32" FontFamily="{StaticResource IrishGrover}" Foreground="#2C3E50" Margin="0,10,0,10"/>
                        </StackPanel>

                        <!-- Values -->
                        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="328,8,-155,0" Grid.ColumnSpan="2">
                            <TextBlock x:Name="txtBkUsername" Width="500" Height="45" Margin="0,10,0,0" FontSize="30" Foreground="#2C3E50"/>
                            <TextBlock x:Name="txtBkName" Width="500" Height="45" Margin="0,10,0,10" FontSize="30" Foreground="#2C3E50"/>
                            <TextBlock x:Name="txtBkEmail" Width="500" Height="45" Margin="0,10,0,10" FontSize="30" Foreground="#2C3E50"/>
                        </StackPanel>

                        <!-- Socials 1 -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,8,20,8" VerticalAlignment="Center">
                                <Image Source="/Images/discord.png" Width="64" Height="64" Margin="0,0,12,0"/>
                                <TextBlock x:Name="txtBkDiscord" Width="280" Height="45" Margin="0,0,0,0" FontSize="30" Foreground="#2C3E50"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,8" VerticalAlignment="Center">
                                <Image Source="/Images/x.png" Width="64" Height="64" Margin="0,0,12,0"/>
                                <TextBlock x:Name="txtBkX" Width="280" Height="45" Margin="0,0,0,0" FontSize="30" Foreground="#2C3E50"/>
                            </StackPanel>
                        </Grid>

                        <!-- Socials 2 -->
                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,8,20,8" VerticalAlignment="Center">
                                <Image Source="/Images/instagram.png" Width="64" Height="64" Margin="0,0,12,0"/>
                                <TextBlock x:Name="txtBkInstagram" Width="280" Height="45" Margin="0,0,0,0" FontSize="30" Foreground="#2C3E50"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,8" VerticalAlignment="Center">
                                <Image Source="/Images/facebook.png" Width="64" Height="64" Margin="0,0,12,0"/>
                                <TextBlock x:Name="txtBkFacebook" Width="280" Height="45" Margin="0,0,0,0" FontSize="30" Foreground="#2C3E50"/>
                            </StackPanel>
                        </Grid>
                        <!-- Button -->
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</Page>