<UserControl x:Class="Forbbiden.Client.Controls.UserControlCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Forbbiden.Client.View.Games"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="150">
    <Grid
        MouseEnter="Card_MouseEnter"
        MouseLeave="Card_MouseLeave"
        Background="#734714"
        Cursor="Hand" >
        <Image x:Name="cardImage"
               Height="110" Width="140"
               Stretch="UniformToFill" />
    </Grid>
</UserControl>
