<UserControl x:Class="Forbbiden.Client.Controls.UserControlTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Forbbiden.Client.view.games"
             mc:Ignorable="d" 
             d:DesignHeight="135" d:DesignWidth="145">

    <Border x:Name="tile"
            Height="115" Width="115"
            Margin="5"
            Background="LightGray"
            BorderBrush="#03A300"
            BorderThickness="8"
            MouseLeftButtonDown="MoveAvatar_MouseLeftButtonDown"
            MouseEnter="ColorStroke_MouseEnter"
            MouseLeave="ColorStroke_MouseLeave">
        <Grid x:Name="tileGrid" >
            <Image x:Name="tileImage" Stretch="Uniform" />
        </Grid>
    </Border>
</UserControl>
