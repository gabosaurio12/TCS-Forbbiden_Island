<UserControl x:Class="Forbbiden.Client.Controls.UserControlFriend"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:language="clr-namespace:Forbbiden.Client.Properties.Langs"
             xmlns:local="clr-namespace:Forbbiden.Client.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="800">
    
    <StackPanel Orientation="Horizontal"
                Background="LightGray">

        <Ellipse x:Name="avatarEllipse"
                 Height="100" Width="100"
                 VerticalAlignment="Center"
                 Margin="20,20,0,20">
            <Ellipse.Fill>
                <ImageBrush ImageSource="/avatars/defaultAvatar.png" />
            </Ellipse.Fill>
        </Ellipse>

        <TextBlock x:Name="usernameTxtBk"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource IrishGrover}"
                   FontSize="48"
                   Text="{x:Static language:Resources.username}"
                   Margin="50,0,0,0" />


    </StackPanel>
</UserControl>
