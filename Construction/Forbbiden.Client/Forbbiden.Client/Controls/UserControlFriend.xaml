<UserControl x:Class="Forbbiden.Client.Controls.UserControlFriend"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:language="clr-namespace:Forbbiden.Client.Properties"
             xmlns:local="clr-namespace:Forbbiden.Client.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="800">
    
    <Grid Background="LightGray"
          Width="800" Height="150">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="170" />
        </Grid.ColumnDefinitions>

        <Ellipse x:Name="avatarEllipse" Grid.Column="0"
                 Height="100" Width="100"
                 VerticalAlignment="Center" HorizontalAlignment="Center" >
            <Ellipse.Fill>
                <ImageBrush ImageSource="/avatars/defaultAvatar.png" />
            </Ellipse.Fill>
        </Ellipse>

        <TextBlock x:Name="usernameTxtBk" Grid.Column="1"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource IrishGrover}"
                   FontSize="48"
                   Text="{x:Static language:Resources.username}"
                   Margin="0,0,0,0" />

        <StackPanel Orientation="Horizontal" Grid.Column="2">
            <Image x:Name="profileImage"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Margin="10,0,10,0"
                   Source="/Images/profile_px.png"
                   Width="60" Height="70"
                   MouseEnter="Image_MouseEnter"
                   MouseLeave="Image_MouseLeave"
                   Cursor="Hand" />

            <Image x:Name="recycleBin" Grid.Column="2"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Margin="10,0,10,0"
                   Source="/Images/recycle_bin.png" 
                   Width="60" Height="70"
                   MouseEnter="Image_MouseEnter"
                   MouseLeave="Image_MouseLeave"
                   Cursor="Hand"/>
        </StackPanel>

        
    </Grid>
</UserControl>
