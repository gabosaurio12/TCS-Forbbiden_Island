    name="NetTcpBinding_IFriendsManager1" />
   <endpoint address="net.tcp://localhost:8085/TokenManager" binding="netTcpBinding"
    bindingConfiguration="NetTcpBinding_ITokenManager1" contract="TokenManager.ITokenManager"
    name="NetTcpBinding_ITokenManager1" />
   <endpoint address="net.tcp://localhost:8081/ProfileManager" binding="netTcpBinding"
    bindingConfiguration="NetTcpBinding_IProfileManager1" contract="ProfileManager.IProfileManager"
    name="NetTcpBinding_IProfileManager1" />
   <endpoint address="net.tcp://localhost:8083/MatchManager" binding="netTcpBinding"
    bindingConfiguration="NetTcpBinding_IMatchManager1" contract="MatchManager.IMatchManager"
    name="NetTcpBinding_IMatchManager1" />
   <endpoint address="net.tcp://localhost:9030/GameManager" binding="netTcpBinding"
    bindingConfiguration="NetTcpBinding_IGameManager1" contract="GameManager.IGameManager"
