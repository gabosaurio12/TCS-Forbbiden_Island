    contract="FriendsNotificationManager.IFriendsNotificationManager"
    name="NetTcpBinding_IFriendsNotificationManager1" />
  </client>

	</system.serviceModel>

	<userSettings>
		<Forbbiden.Client.Properties.PlayerSettings>
			<setting name="CurrentPlayerId" serializeAs="String">
				<value>0</value>
			</setting>
		</Forbbiden.Client.Properties.PlayerSettings>
		<Forbbiden.Client.Properties.Settings>
			<setting name="languageCode" serializeAs="String">
