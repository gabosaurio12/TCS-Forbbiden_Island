<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Forbbiden.Server.Properties.email" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Forbbiden.Server.Properties.email" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <system.serviceModel>
    <behaviors>
      <serviceBehaviors>
        <behavior name="mexBehavior">
          <serviceMetadata httpGetEnabled="false" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
        <behavior name="">
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <service behaviorConfiguration="mexBehavior" name="Forbbiden.Server.logic.ProfileManager">
        <endpoint address="" binding="netTcpBinding" contract="Forbbiden.Contracts.IProfileManager" />
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8081/ProfileManager" />
            <add baseAddress="http://localhost:8080/ProfileManager" />
          </baseAddresses>
        </host>
      </service>
      <service behaviorConfiguration="mexBehavior" name="Forbbiden.Server.logic.FriendsManager">
        <endpoint address="" binding="netTcpBinding" contract="Forbbiden.Contracts.IFriendsManager" />
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8081/FriendsManager" />
            <add baseAddress="http://localhost:8080/FriendsManager" />
          </baseAddresses>
        </host>
      </service>
      <service behaviorConfiguration="mexBehavior" name="Forbbiden.Server.logic.MatchManager">
        <endpoint address="" binding="netTcpBinding" contract="Forbbiden.Contracts.IMatchManager" />
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8083/MatchManager" />
          </baseAddresses>
        </host>
      </service>
    </services>
  </system.serviceModel>
  <applicationSettings>
    <Forbbiden.Server.Properties.email>
      <setting name="emailCode" serializeAs="String">
        <value>uqeosliojdotaitq</value>
      </setting>
      <setting name="emailAddress" serializeAs="String">
        <value>forbbidenislandfei@gmail.com</value>
      </setting>
    </Forbbiden.Server.Properties.email>
  </applicationSettings>
  <userSettings>
    <Forbbiden.Server.Properties.email>
      <setting name="smtp" serializeAs="String">
        <value>smtp.gmail.com</value>
      </setting>
    </Forbbiden.Server.Properties.email>
  </userSettings>

</configuration>